@inherits LandingComponent

<MudStack Class="fd-footer">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <MudGrid Spacing="4" Class="align-center">
            <MudItem xs="12" md="4">
                <MudStack Spacing="2">
                    <BrandMark />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@T(Copy.Footer.Tagline)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@T(Copy.Footer.Line)</MudText>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudStack Row Spacing="4" Justify="Justify.Center">
                    <MudLink Href="@Sections.PrivacyUrl" Target="_blank" rel="noopener" Color="Color.Dark" Typo="Typo.body2">@T(Copy.Footer.Privacy)</MudLink>
                    <MudLink Href="@Sections.TermsUrl" Target="_blank" rel="noopener" Color="Color.Dark" Typo="Typo.body2">@T(Copy.Footer.Terms)</MudLink>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudStack Spacing="2" AlignItems="AlignItems.Center">
                    <StoreBadges Center="true" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@T(Copy.Footer.Copyright)</MudText>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudStack>
