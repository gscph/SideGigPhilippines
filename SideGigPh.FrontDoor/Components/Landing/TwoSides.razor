@inherits LandingComponent

<MudContainer MaxWidth="MaxWidth.Large" Class="fd-section" id="@Sections.HowItWorks">
    <MudStack Spacing="5">
        <MudText Typo="Typo.h4" HtmlTag="h2">@T(Copy.Sides.Heading)</MudText>
        <MudToggleGroup T="string" Value="@Side" ValueChanged="PickSide" SelectionMode="SelectionMode.SingleSelection"
                        Color="Color.Primary" Outlined="true" Class="fd-sides">
            <MudToggleItem Value="@EarlyAccessRules.Household" Text="@T(Copy.Sides.Household)" />
            <MudToggleItem Value="@EarlyAccessRules.Worker" Text="@T(Copy.Sides.Worker)" />
        </MudToggleGroup>
        @if (IsWorker)
        {
            <MudText Typo="Typo.subtitle1" Color="Color.Success">@T(Copy.Sides.WorkerIntro)</MudText>
        }
        <MudGrid Spacing="4" Class="fd-steps">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var step = Steps[i];
                var number = i + 1;
                <MudItem xs="12" md="4">
                    <MudStack Row Spacing="3" AlignItems="AlignItems.Start">
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fd-step-number">
                            <MudText Typo="Typo.subtitle1">@number</MudText>
                        </MudStack>
                        <MudStack Spacing="1">
                            <IconCircle Src="@step.Icon" Size="48" />
                            <MudText Typo="Typo.h6" HtmlTag="h3">@T(step.Title)</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@T(step.Text)</MudText>
                        </MudStack>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </MudStack>
</MudContainer>
