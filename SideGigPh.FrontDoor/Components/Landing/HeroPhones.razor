@inherits LandingComponent

@* Two real app screens, tilted like cards on the purple band: a household's results behind, a worker's offer in front.
   Each frame shows only the phone of a store screenshot (the crop is fd-phone-shot in frontdoor.css). *@
<MudStack Class="fd-phones">
    <MudStack Class="fd-phone fd-phone-back">
        <MudImage Src="images/app/search-results.png" Alt="@T(Copy.Hero.ShotSearch)" Class="fd-phone-shot" />
    </MudStack>
    <MudStack Class="fd-phone fd-phone-front">
        <MudImage Src="images/app/request-offer.png" Alt="@T(Copy.Hero.ShotOffer)" Class="fd-phone-shot" />
    </MudStack>
</MudStack>
