@inherits LandingComponent

<MudContainer MaxWidth="MaxWidth.Medium" Class="fd-section" id="@Sections.Faq">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4" HtmlTag="h2">@T(Copy.Faq.Heading)</MudText>
        <MudExpansionPanels MultiExpansion="false" Elevation="0" Outlined="true" Class="fd-faq">
            @foreach (var (question, answer) in Copy.Faq.Items)
            {
                <MudExpansionPanel Text="@T(question)">
                    <MudText Typo="Typo.body1" Color="Color.Secondary">@T(answer)</MudText>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudStack>
</MudContainer>
