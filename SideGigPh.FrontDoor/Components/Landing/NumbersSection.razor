@inherits LandingComponent

<MudContainer MaxWidth="MaxWidth.Large" Class="fd-section">
    <SectionTitle Lead="@T(Copy.Titles.Numbers.Lead)" Mark="@T(Copy.Titles.Numbers.Mark)" />
    <MudGrid Spacing="4" Class="mt-6">
        @foreach (var item in Items)
        {
            <MudItem xs="6" md="3">
                <MudPaper Elevation="0" Class="fd-card fd-number-card pa-6">
                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="fd-number">
                            <MudText Typo="Typo.h3" HtmlTag="span" Color="Color.Primary">@item.Count</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h5" HtmlTag="h3" Align="Align.Center">@T(item.Title)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@T(item.Text)</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudContainer>
