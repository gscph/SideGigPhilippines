<MudStack Row Spacing="4" AlignItems="AlignItems.Start">
    <IconCircle Src="@Icon" Size="64" OnDark="@OnTint" />
    <MudStack Spacing="1">
        <MudText Typo="Typo.h6" HtmlTag="h3" Color="@TitleColor">@Title</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@Text</MudText>
    </MudStack>
</MudStack>
