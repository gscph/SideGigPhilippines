@inherits LandingComponent

<MudStack Class="fd-band-tint">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="fd-section">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <BrandMark />
            <MudText Typo="Typo.h3" HtmlTag="h2" Align="Align.Center">@T(Signup.HasJoined ? Copy.Repeat.ThanksHeadline : Copy.Repeat.Headline)</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">@T(Signup.HasJoined ? Copy.Repeat.ThanksSub : Copy.Repeat.Sub)</MudText>
            <MudStack Row Spacing="3" Justify="Justify.Center" Wrap="Wrap.Wrap" Class="mt-2">
                @if (Signup.HasJoined)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Share" Class="fd-pill" OnClick="ShareAsync">
                        @T(_copied ? Copy.Join.Copied : Copy.Repeat.Share)
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="fd-pill" OnClick="ToFormAsync">@T(Copy.Repeat.Button)</MudButton>
                }
                <MudButton Href="@Sections.TestFlightUrl" Target="_blank" rel="noopener" Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Large"
                           StartIcon="@Icons.Custom.Brands.Apple" Class="fd-pill">@T(Copy.Repeat.Iphone)</MudButton>
            </MudStack>
        </MudStack>
    </MudContainer>
</MudStack>
