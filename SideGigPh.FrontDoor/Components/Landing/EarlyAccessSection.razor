@inherits LandingComponent

<MudStack Class="fd-band-primary fd-hero-band fd-dots-right" id="@Sections.EarlyAccess">
    <MudContainer MaxWidth="MaxWidth.Large" Class="fd-section">
        <MudGrid Spacing="6" Class="align-center">
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.overline" Class="fd-on-primary-muted">@T(Copy.Join.Eyebrow)</MudText>
                    <MudText Typo="Typo.h3" HtmlTag="h2">@T(Copy.Join.Headline)</MudText>
                    <MudText Typo="Typo.body1" Class="fd-on-primary-muted">@T(Copy.Join.Sub)</MudText>
                    <MudStack Spacing="2" Class="mt-2">
                        @foreach (var bullet in Bullets)
                        {
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                                <MudText Typo="Typo.body1">@T(bullet)</MudText>
                            </MudStack>
                        }
                    </MudStack>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudPaper Elevation="3" Class="fd-form-card">
                    <EarlyAccessForm />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudStack>
