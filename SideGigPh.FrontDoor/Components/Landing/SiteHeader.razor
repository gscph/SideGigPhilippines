@inherits LandingComponent

<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="fd-header">
    <MudButton Variant="Variant.Text" Class="fd-plain-button" OnClick="ToTopAsync" aria-label="@T(Copy.Header.Home)">
        <BrandMark />
    </MudButton>
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <MudButton Variant="Variant.Text" Color="Color.Dark" OnClick="@(() => ScrollAsync(Sections.HowItWorks))">@T(Copy.Header.HowItWorks)</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Dark" OnClick="@(() => ScrollAsync(Sections.Trades))">@T(Copy.Header.Trades)</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Dark" OnClick="@(() => ScrollAsync(Sections.Faq))">@T(Copy.Header.Faq)</MudButton>
        </MudHidden>
        <LanguageToggle />
        @if (!_formOnScreen)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="fd-header-cta" OnClick="ToFormAsync">
                @T(Copy.Header.EarlyAccess)
            </MudButton>
        }
    </MudStack>
</MudStack>
