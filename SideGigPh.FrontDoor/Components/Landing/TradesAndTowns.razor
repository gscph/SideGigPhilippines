@inherits LandingComponent

<MudContainer MaxWidth="MaxWidth.Large" Class="fd-section" id="@Sections.Trades">
    <MudStack Spacing="6">
        <SectionTitle Lead="@T(Copy.Titles.Trades.Lead)" Mark="@T(Copy.Titles.Trades.Mark)" Sub="@T(Copy.Trades.Heading)" />
        <MudStack AlignItems="AlignItems.Center">
            <MudToggleGroup T="bool" @bind-Value="_construction" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Outlined="false" Delimiters="false" Class="fd-pills">
                <MudToggleItem Value="false" Text="@T(Copy.Trades.AllTrades)" />
                <MudToggleItem Value="true" Text="@T(Copy.Trades.Construction)" />
            </MudToggleGroup>
        </MudStack>
        <MudGrid Spacing="3" Justify="Justify.Center">
            @foreach (var trade in Tiles)
            {
                <MudItem xs="6" sm="4" md="2">
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="fd-trade-tile">
                        <MudImage Src="@trade.Icon" Alt="" Width="56" Height="56" />
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">@T(trade.Label)</MudText>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>

        <MudStack Class="mt-6">
            <ServiceList />
        </MudStack>

        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="mt-6">
            <MudText Typo="Typo.h5" HtmlTag="h2" Align="Align.Center">@T(Copy.Trades.TownsHeading)</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">@T(Copy.Trades.TownsSub)</MudText>
        </MudStack>
        <MudGrid Spacing="3">
            @foreach (var town in TradeList.Towns)
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="@(town.First ? "fd-card fd-card-first pa-5" : "fd-card pa-5")">
                        <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                            <IconCircle Src="images/icons/pin.svg" Size="48" />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6" HtmlTag="h3">@town.Name</MudText>
                                @if (town.First)
                                {
                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="ma-0">@T(Copy.Trades.First)</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Small" Class="ma-0">@T(Copy.Trades.Next)</MudChip>
                                }
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@T(Copy.Trades.TownsFootnote)</MudText>
    </MudStack>
</MudContainer>
