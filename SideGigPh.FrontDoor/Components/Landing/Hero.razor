@inherits LandingComponent

<MudStack Class="fd-band-primary fd-hero-band">
    <MudContainer MaxWidth="MaxWidth.Large" Class="fd-hero">
        <MudGrid Spacing="6" Class="align-center">
            <MudItem xs="12" md="6" Class="order-md-1">
                <MudStack Spacing="3">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudIcon Icon="@FrontDoorTheme.Logo" ViewBox="0 0 24 24" Color="Color.Inherit" Class="fd-hero-logo" />
                        <MudText Typo="Typo.h4" HtmlTag="span" Class="fd-wordmark">Tarbaho</MudText>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" Class="fd-eyebrow fd-eyebrow-dark fd-hero-eyebrow">@T(Copy.Hero.Eyebrow)</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.h2" HtmlTag="h1" Class="fd-hero-title">@T(Copy.Hero.Headline)</MudText>
                    <MudText Typo="Typo.body1" Class="fd-on-primary-muted fd-hero-sub">@T(Copy.Hero.Sub)</MudText>
                    <MudPaper Elevation="3" Class="fd-form-card fd-hero-form" id="@Sections.EarlyAccess">
                        <EarlyAccessForm />
                    </MudPaper>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="6" Class="order-md-0">
                <HeroPhones />
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudStack>
