<Project Sdk="Microsoft.NET.Sdk">

  <!-- SideGigPh's Azure SQL data access (EF Core). Only SideGigPh.Api references it; the phone never
       talks to the database. The schema is Sql/001-schema.sql (no EF migrations): keep SideGigPhDb in step with it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SideGigPh.Contracts\SideGigPh.Contracts.csproj" />
  </ItemGroup>

  <!-- SideGigPh.Tests checks the data rules in StoreText (internal) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SideGigPh.Tests" />
  </ItemGroup>

</Project>
