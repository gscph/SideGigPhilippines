<Project Sdk="Microsoft.NET.Sdk">

  <!-- The JSON the app and SideGigPh.Api send each other. No dependencies, so the phone app
       (net10.0-android / -ios) and the Azure Functions server can both reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
