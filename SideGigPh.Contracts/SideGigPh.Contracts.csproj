<Project Sdk="Microsoft.NET.Sdk">

  <!-- The JSON the app and SideGigPh.Api send each other. No dependencies, so the phone app
       (net10.0-android / -ios) and the Azure Functions server can both reference it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The blocked-words lists (BlockedWords), read from the assembly so the phone and the server use the same ones. -->
  <ItemGroup>
    <EmbeddedResource Include="Moderation/blocked-words.txt" LogicalName="SideGigPh.Contracts.blocked-words.txt" />
    <EmbeddedResource Include="Moderation/blocked-patterns.txt" LogicalName="SideGigPh.Contracts.blocked-patterns.txt" />
  </ItemGroup>

</Project>
