<Project Sdk="Microsoft.NET.Sdk">

    <!-- MobileAppTheme.Firebase: the Firebase adapters for the skeleton's IIdentityProvider (phone
         SMS code + Google) and IPushNotifications (Cloud Messaging), Android + iOS only. Optional: an app that
         uses another provider references that provider's project instead (see README.md).
         A plain MAUI library (Microsoft.NET.Sdk, not Razor), so MAUI doesn't add the WebView host
         package and its static assets don't clash with the app's. -->
    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

        <RootNamespace>MobileAppTheme.Firebase</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

        <!-- The MODULAR Auth packages, NOT the bundled "Plugin.Firebase": the bundle pulls in
             Crashlytics, which auto-inits at launch and crashes in MAUI. PrivateAssets="none" lets
             their build targets flow to the app, which needs them to process google-services.json. -->
        <PackageReference Include="Plugin.Firebase.Auth" Version="3.1.1" PrivateAssets="none" />
        <PackageReference Include="Plugin.Firebase.Auth.Google" Version="3.1.2" PrivateAssets="none" />
        <!-- New-message notifications (FirebasePushNotifications), the same modular family. -->
        <PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.1.2" PrivateAssets="none" />
    </ItemGroup>

    <!-- Optional parts, each behind a build flag (../Directory.Build.props, off by default). Off: the package isn't
         referenced and AddFirebaseAnalytics / AddFirebaseExperiments leave the skeleton's do-nothing adapter in place,
         so the app builds and runs with nothing set up in the Firebase console. -->
    <PropertyGroup Condition="'$(FirebaseAnalytics)' == 'true'">
        <DefineConstants>$(DefineConstants);FIREBASE_ANALYTICS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(FirebaseExperiments)' == 'true'">
        <DefineConstants>$(DefineConstants);FIREBASE_EXPERIMENTS</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(FirebaseAnalytics)' == 'true'">
        <!-- Google Analytics for Firebase behind IAnalytics (FirebaseAnalytics.cs). -->
        <PackageReference Include="Plugin.Firebase.Analytics" Version="3.1.1" PrivateAssets="none" />
    </ItemGroup>
    <ItemGroup Condition="'$(FirebaseExperiments)' == 'true'">
        <!-- Firebase Remote Config (the values A/B Testing hands out) behind IExperiments (FirebaseExperiments.cs). -->
        <PackageReference Include="Plugin.Firebase.RemoteConfig" Version="3.1.1" PrivateAssets="none" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MobileAppTheme\MobileAppTheme.csproj" />
    </ItemGroup>

</Project>
