<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the SQL scripts the live database hasn't had yet (SideGigPh.AzureSQL/Sql), in order, then 004-config.
       Used by .github/workflows/database.yml (called by deploy-api.yml before the API deploys when scripts changed); also runnable by hand (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>

</Project>
