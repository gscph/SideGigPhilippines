<Project Sdk="Microsoft.NET.Sdk">

  <!-- SideGigPh's server: Azure Functions (isolated worker). Photos go to Azure Blob Storage; users,
       listings, reviews and chats to Azure SQL through SideGigPh.AzureSQL (docs/data-model.md).
       Secrets (the storage and SQL connection strings) live in the Function App's settings, never in the phone app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The version label and git commit go into the assembly (../Directory.Build.targets), read by ApiVersion. -->
    <StampBuildInfo>true</StampBuildInfo>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="FirebaseAdmin" Version="3.7.0" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SideGigPh.AzureSQL\SideGigPh.AzureSQL.csproj" />
    <ProjectReference Include="..\SideGigPh.Contracts\SideGigPh.Contracts.csproj" />
  </ItemGroup>

  <!-- SideGigPh.Tests calls the internal helpers (ApiResults, ErrorDetailsMiddleware) in its tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SideGigPh.Tests" />
  </ItemGroup>

  <!-- The public legal pages (GET legal/{page}, LegalFunctions): docs/legal/ is their one source. -->
  <ItemGroup>
    <EmbeddedResource Include="..\docs\legal\privacy-policy.md" LogicalName="legal/privacy-policy.md" />
    <EmbeddedResource Include="..\docs\legal\terms-of-service.md" LogicalName="legal/terms-of-service.md" />
    <EmbeddedResource Include="..\docs\legal\data-handling.md" LogicalName="legal/data-handling.md" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
