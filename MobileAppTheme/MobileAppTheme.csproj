<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- MobileAppTheme: the reusable app skeleton (shell, theme, generic components, localization,
         device adapters) for .NET MAUI Blazor Hybrid apps on Android + iOS. It must never reference
         an app project. See README.md and CLAUDE.md in this folder.

         A plain net10.0 Razor class library, the shape Microsoft's MAUI Blazor Hybrid templates use
         for shared UI. Not UseMaui: that implicitly adds the WebView host package, whose static assets
         then clash with the app's (_framework/blazor.modules.json). Phone APIs come from
         Microsoft.Maui.Essentials, whose net10.0 build is swapped for the Android/iOS one inside the app. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>MobileAppTheme</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="android" />
        <SupportedPlatform Include="ios" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" />
        <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.110" />
        <!-- The one MudBlazor version for every app built on the skeleton. -->
        <PackageReference Include="MudBlazor" Version="9.12.0" />
    </ItemGroup>

</Project>
