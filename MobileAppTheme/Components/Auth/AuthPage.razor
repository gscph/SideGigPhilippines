@page "/verify"

<SheetPage Title="@T.Get(_sentTo is null ? CommonCopy.AuthTitle : CommonCopy.AuthCodeTitle)" OnBack="BackHandler">
    @if (_sentTo is null)
    {
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5" HtmlTag="h2">@T.Format(CommonCopy.AuthWelcome, Brand.Name)</MudText>
            @if (Brand.Tagline is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Brand.Tagline)</MudText>
            }
        </MudStack>
    }

    @if (HasApple && _sentTo is null)
    {
        <AppleSignInButton OnAuthenticated="HandleAuthenticatedAsync" />
    }

    @if (HasGoogle && _sentTo is null)
    {
        <GoogleSignInButton OnAuthenticated="HandleAuthenticatedAsync" />
    }

    @if (ShowPhone)
    {
        @if (HasOtherMethod && _sentTo is null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudDivider Class="flex-1" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(CommonCopy.AuthOr)</MudText>
                <MudDivider Class="flex-1" />
            </MudStack>
        }
        <PhoneSignIn @ref="_phone" OnAuthenticated="HandleAuthenticatedAsync" SentToChanged="SentToChanged" />
    }
    else if (HasPhone)
    {
        <MudButton Variant="Variant.Text" Class="app-link-button" OnClick="UsePhone">@T.Get(CommonCopy.AuthUsePhone)</MudButton>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@_error</MudAlert>
    }

    @if (_sentTo is null)
    {
        <LegalConsent />
    }
</SheetPage>
