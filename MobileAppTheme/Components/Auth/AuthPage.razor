@page "/verify"

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="6" Class="full-screen py-8">
        <BrandMark Tagline="@(Brand.Tagline is null ? null : T.Get(Brand.Tagline))" />

        <MudPaper Outlined="true" Elevation="2" Class="pa-6 mud-width-full">
            <MudStack Spacing="5">
                <MudText Typo="Typo.h6" HtmlTag="h1" Align="Align.Center">@T.Get(CommonCopy.AuthTitle)</MudText>

                @if (HasPhone)
                {
                    <PhoneSignIn OnAuthenticated="HandleAuthenticatedAsync" />
                }

                @if (HasPhone && HasGoogle)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudDivider Class="flex-1" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@T.Get(CommonCopy.AuthOr)</MudText>
                        <MudDivider Class="flex-1" />
                    </MudStack>
                }

                @if (HasGoogle)
                {
                    <GoogleSignInButton OnAuthenticated="HandleAuthenticatedAsync" />
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>
