@page "/verify/phone"

<SheetPage Title="@T.Get(_sentTo is null ? CommonCopy.AuthPhoneTitle : CommonCopy.AuthCodeTitle)" OnBack="GoBackAsync">
    @if (_sentTo is null)
    {
        <MudText Typo="Typo.body1" Color="Color.Secondary">@T.Get(CommonCopy.AuthPhoneWhy)</MudText>
    }

    <PhoneSignIn @ref="_phone" LinkToCurrentUser="true" OnAuthenticated="HandleLinked" SentToChanged="SentToChanged" />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@_error</MudAlert>
    }

    @if (Skip)
    {
        <MudButton Variant="Variant.Text" Class="app-link-button" Disabled="_busy" OnClick="Later">@T.Get(CommonCopy.AuthLater)</MudButton>
    }

    @if (_phoneInUse)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Large" FullWidth="true" Disabled="_busy" OnClick="SignInWithNumberAsync">
            @T.Get(CommonCopy.AuthSignInWithNumber)
        </MudButton>
    }
</SheetPage>
