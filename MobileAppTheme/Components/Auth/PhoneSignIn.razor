<MudStack Spacing="4">
    @if (_step == Step.EnterPhone)
    {
        <MudStack Spacing="0" Class="app-field-group">
            @if (!string.IsNullOrEmpty(PhoneFormat.Region))
            {
                <MudTextField T="string" Value="@PhoneFormat.Region" ReadOnly="true" Variant="Variant.Filled" Underline="false"
                              Label="@T.Get(CommonCopy.AuthRegionLabel)" Class="app-field" />
            }
            <MudTextField T="string" @bind-Value="_phoneNumber" Immediate="true" Disabled="_busy" Variant="Variant.Filled" Underline="false"
                          Label="@T.Get(CommonCopy.AuthPhoneLabel)" Placeholder="@PhoneFormat.Placeholder" Class="app-field"
                          InputType="InputType.Telephone" InputMode="InputMode.tel" autocomplete="tel" />
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(CommonCopy.AuthPhoneHint)</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Large" FullWidth="true"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_phoneNumber))" OnClick="SendCodeAsync">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" aria-label="@T.Get(CommonCopy.AuthSending)" />
            }
            else
            {
                @T.Get(CommonCopy.AuthContinue)
            }
        </MudButton>
    }
    else
    {
        <MudText Typo="Typo.body1">@T.Format(CommonCopy.AuthCodeSent, _sentTo ?? string.Empty)</MudText>
        <MudTextField T="string" @bind-Value="_code" Immediate="true" Disabled="_busy" Variant="Variant.Filled" Underline="false"
                      Label="@T.Get(CommonCopy.AuthCodeLabel)" MaxLength="6" Class="app-field app-field-code"
                      InputMode="InputMode.numeric" autocomplete="one-time-code" />
        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Large" FullWidth="true"
                   Disabled="@(_busy || string.IsNullOrWhiteSpace(_code))" OnClick="VerifyAsync">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" aria-label="@T.Get(CommonCopy.AuthVerifying)" />
            }
            else
            {
                @T.Get(CommonCopy.AuthContinue)
            }
        </MudButton>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(CommonCopy.AuthNoCode)</MudText>
            <MudButton Variant="Variant.Text" Class="app-link-button" Disabled="_busy" OnClick="UseOtherNumberAsync">
                @T.Get(CommonCopy.AuthOtherNumber)
            </MudButton>
        </MudStack>
    }
</MudStack>
