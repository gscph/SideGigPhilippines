@if (Compact)
{
    <MudGrid Spacing="3" role="group">
        @foreach (var item in Items)
        {
            <MudItem xs="12">
                <ChoiceTile Item="item" Selected="SelectedIds.Contains(item.Id)" ShowCheck="Multiple" OnPick="OnPick" />
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudStack Spacing="3" role="group">
        @foreach (var item in Items)
        {
            <ChoiceTile Item="item" Selected="SelectedIds.Contains(item.Id)" ShowCheck="Multiple" OnPick="OnPick" />
        }
    </MudStack>
}
