<MudAvatar Color="Color.Dark" Variant="Variant.Filled" Size="Size"
           Class="@Class" aria-hidden="true">
    @if (PhotoUrl is not null)
    {
        <MudImage Src="@PhotoUrl" Alt="" ObjectFit="ObjectFit.Cover" />
    }
    else if (Initials.Length > 0)
    {
        @Initials
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.Person" />
    }
</MudAvatar>
