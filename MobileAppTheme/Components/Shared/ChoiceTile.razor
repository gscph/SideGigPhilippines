<MudButton Variant="Variant.Text" Color="Color.Dark" FullWidth="true" Ripple="false"
           Class="@CssClass" aria-pressed="@(Selected ? "true" : "false")"
           OnClick="() => OnPick.InvokeAsync(Item.Id)">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="mud-width-full">
        <MudStack Spacing="0" Class="flex-1">
            <MudText Typo="Typo.subtitle1" Color="Color.Dark">@Item.Label</MudText>
            @if (!string.IsNullOrEmpty(Item.Hint))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Item.Hint</MudText>
            }
        </MudStack>
        @if (!string.IsNullOrEmpty(Item.Icon))
        {
            <MudImage Src="@Item.Icon" Alt="" Width="32" Height="32" Class="flex-shrink-0" aria-hidden="true" />
        }
        @if (ShowCheck)
        {
            <MudIcon Icon="@(Selected ? Icons.Material.Rounded.CheckBox : Icons.Material.Rounded.CheckBoxOutlineBlank)"
                     Color="@(Selected ? Color.Primary : Color.Secondary)" aria-hidden="true" />
        }
    </MudStack>
</MudButton>
