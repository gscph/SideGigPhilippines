<MudOverlay Visible="_visible" LightBackground="true" Modal="true" LockScroll="true" ZIndex="2000">
    <MudStack AlignItems="AlignItems.Center" Spacing="4" role="status" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6" Color="Color.Dark">@T.Get(Words[_word])</MudText>
    </MudStack>
</MudOverlay>
