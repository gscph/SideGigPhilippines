<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudStack Justify="Justify.Center" Spacing="8" Class="full-screen px-4 py-8" role="status" aria-live="polite">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
        <MudStack Spacing="5" Class="mud-width-full">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var done = i < _done;
                var active = i == _done;
                var label = Steps[i];
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudIcon Icon="@(done ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.RadioButtonUnchecked)"
                             Color="@(done ? Color.Primary : Color.Secondary)" aria-hidden="true" />
                    <MudText Typo="@(active ? Typo.subtitle1 : Typo.body1)"
                             Color="@(done || active ? Color.Dark : Color.Secondary)">@label</MudText>
                </MudStack>
            }
        </MudStack>
    </MudStack>
</MudContainer>
