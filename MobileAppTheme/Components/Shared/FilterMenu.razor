<MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" AriaLabel="@Label" MaxHeight="MaxListHeight">
    <ActivatorContent>
        <MudChip T="string" Color="Color.Dark" Variant="Variant.Text" Icon="@Icon" Class="ma-0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                <MudText Typo="Typo.body2" HtmlTag="span">@SelectedLabel</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" aria-hidden="true" />
            </MudStack>
        </MudChip>
    </ActivatorContent>
    <ChildContent>
        @for (var i = 0; i < Options.Count; i++)
        {
            var option = Options[i];
            if (StartsGroup(i))
            {
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-4 pt-2">@option.Group</MudText>
            }
            <MudMenuItem Icon="@(option.Id == SelectedId ? Icons.Material.Filled.Check : null)"
                         OnClick="() => OnPick.InvokeAsync(option.Id)">
                @option.Label
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>
