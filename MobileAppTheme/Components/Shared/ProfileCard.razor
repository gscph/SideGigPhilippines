<MudPaper Elevation="0" Class="app-raised pa-6">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        <PersonAvatar Name="@(Name ?? string.Empty)" PhotoUrl="@PhotoUrl" Class="app-avatar-xl" />
        <MudText Typo="Typo.h5" HtmlTag="h2" Align="Align.Center">@Name</MudText>
        @ChildContent
    </MudStack>
</MudPaper>
