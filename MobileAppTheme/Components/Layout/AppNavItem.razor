<MudLink Href="@Tab.Href" Underline="Underline.None" Color="@(Active ? Color.Dark : Color.Secondary)"
         aria-current="@(Active ? "page" : null)">
    <MudStack AlignItems="AlignItems.Center" Spacing="0">
        <MudBadge Content="Tab.Badge" Max="9" Visible="@(Tab.Badge > 0)" Color="Color.Error" Overlap="true">
            <MudStack AlignItems="AlignItems.Center" Class="@PillClass">
                <MudIcon Icon="@Tab.Icon" aria-hidden="true" />
            </MudStack>
        </MudBadge>
        <MudText Typo="Typo.caption">@Tab.Label</MudText>
    </MudStack>
</MudLink>
