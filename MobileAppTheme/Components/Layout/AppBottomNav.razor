<MudPaper Square="true" Elevation="0" Class="app-bottom-nav border-t border-solid mud-border-lines-default" role="navigation">
    <MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
        <MudStack Row="true" Spacing="0" StretchItems="StretchItems.All" AlignItems="AlignItems.Center" Class="app-bottom-nav-row px-1">
            @foreach (var tab in Tabs)
            {
                <AppNavItem Tab="tab" Active="@(tab == ActiveTab)" />
            }
        </MudStack>
    </MudContainer>
</MudPaper>
