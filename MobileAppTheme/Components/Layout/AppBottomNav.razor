<MudPaper Square="true" Elevation="4" Class="app-bottom-nav" role="navigation">
    <MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
        <MudStack Row="true" Spacing="0" StretchItems="StretchItems.All" Class="px-1 py-1">
            @foreach (var tab in Tabs)
            {
                <AppNavItem Tab="tab" Active="@(tab == ActiveTab)" />
            }
        </MudStack>
    </MudContainer>
</MudPaper>
