<MudAppBar Color="Color.Default" Elevation="0" Fixed="false" Class="sticky app-top-bar border-b border-solid mud-border-lines-default">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-1">
        <MudIcon Icon="@Brand.LogoIcon" Color="Color.Primary" aria-hidden="true" />
        <MudText Typo="Typo.h6" HtmlTag="span" Color="Color.Dark">@Brand.Name</MudText>
    </MudStack>

    <MudLink Href="@ProfileHref" Underline="Underline.None" aria-label="@T.Get(CommonCopy.NavProfile)">
        <MudBadge Dot="true" Overlap="true" Bordered="true" Color="Color.Success" Origin="Origin.BottomRight"
                  Visible="ShowStatusDot">
            <PersonAvatar Name="@(Name ?? string.Empty)" PhotoUrl="@PhotoUrl" />
        </MudBadge>
    </MudLink>
</MudAppBar>
