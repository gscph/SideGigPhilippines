<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iOS capabilities. Each one must also be turned on for the App ID in the Apple Developer portal, and the
     provisioning profile regenerated, or signing fails.
     - Sign in with Apple: App Store 4.8 asks for it because the app offers Google sign-in (FirebaseIdentityProvider).
     - Push Notifications (aps-environment): chat and request alerts through Firebase Cloud Messaging. "production" because
       every iOS build is an App Store-signed CI build (TestFlight uses Apple's production push servers).
     - Keychain (keychain-access-groups, the app's own group, no portal setting needed): Firebase Auth keeps the signed-in
       user in the keychain; without it Google and Apple sign-in succeed on their side and then fail in Firebase
       (Plugin.Firebase.Auth's iOS setup). -->
<plist version="1.0">
<dict>
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <key>aps-environment</key>
    <string>production</string>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.tarbaho.app</string>
    </array>
</dict>
</plist>
