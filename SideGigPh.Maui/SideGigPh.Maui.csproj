<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>SideGigPh.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Disable MAUI CSS handling so Blazor can handle it -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>SideGigPh</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.sidegigph.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#222222" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="160,160" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    </ItemGroup>

    <!-- The reusable app skeleton: shell, theme builder, generic components, localization and
         device adapters. MudBlazor comes from here, so its version is set in one place. -->
    <!-- The sign-in provider: Firebase (phone SMS code + Google) behind the skeleton's
         IIdentityProvider. To switch providers, swap this reference and the AddFirebaseAuth call
         in MauiProgram (see CLAUDE.md "Switching the auth provider"). -->
    <ItemGroup>
        <ProjectReference Include="..\MobileAppTheme\MobileAppTheme.csproj" />
        <ProjectReference Include="..\MobileAppTheme.Firebase\MobileAppTheme.Firebase.csproj" />
        <!-- The JSON shapes SideGigPh.Api sends and takes (Services/Api/). -->
        <ProjectReference Include="..\SideGigPh.Contracts\SideGigPh.Contracts.csproj" />
    </ItemGroup>

    <!-- Android signing: one fingerprint everywhere, so Firebase (Google sign-in, phone attestation)
         recognises the APK on every PC and in CI. See docs/android-signing.md.
         - Default (Debug and Release on any machine): the shared dev key committed in
           Platforms/Android/Signing/dev.keystore. Its SHA-1/SHA-256 are registered in Firebase.
         - Store release: set ReleaseKeystore (path) + ReleaseKeyAlias, and the passwords in the
           SIDEGIGPH_KEYSTORE_PASS / SIDEGIGPH_KEY_PASS environment variables (never in this file).
           CI does this from GitHub secrets. -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
        <ReleaseKeystore Condition="'$(ReleaseKeystore)' == ''">$(SIDEGIGPH_KEYSTORE)</ReleaseKeystore>
        <ReleaseKeyAlias Condition="'$(ReleaseKeyAlias)' == ''">$(SIDEGIGPH_KEY_ALIAS)</ReleaseKeyAlias>
        <AndroidKeyStore>true</AndroidKeyStore>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) And ('$(Configuration)' != 'Release' Or '$(ReleaseKeystore)' == '' Or !Exists('$(ReleaseKeystore)'))">
        <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)Platforms\Android\Signing\dev.keystore</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>android</AndroidSigningStorePass>
        <AndroidSigningKeyPass>android</AndroidSigningKeyPass>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) And '$(Configuration)' == 'Release' And '$(ReleaseKeystore)' != '' And Exists('$(ReleaseKeystore)')">
        <AndroidSigningKeyStore>$(ReleaseKeystore)</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>$(ReleaseKeyAlias)</AndroidSigningKeyAlias>
        <AndroidSigningStorePass>env:SIDEGIGPH_KEYSTORE_PASS</AndroidSigningStorePass>
        <AndroidSigningKeyPass>env:SIDEGIGPH_KEY_PASS</AndroidSigningKeyPass>
    </PropertyGroup>

    <!-- Firebase config files. Referenced only when present so the build works without them.
         Supply these from your Firebase project before an Android/iOS run. -->
    <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
        <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
    </ItemGroup>
    <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
        <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="Exists('Platforms\iOS\GoogleService-Info.plist')" />
    </ItemGroup>

</Project>
