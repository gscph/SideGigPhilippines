<MudStack Spacing="0" Class="app-field-group">
    <MudNumericField T="int?" Value="@Min" ValueChanged="MinChanged" Immediate="true" HideSpinButtons="true"
                     Variant="Variant.Filled" Underline="false" Class="app-field" InputMode="InputMode.numeric"
                     Label="@T.Get(Copy.BudgetFromLabel)" HelperText="@Help" />
    <MudNumericField T="int?" Value="@Max" ValueChanged="MaxChanged" Immediate="true" HideSpinButtons="true"
                     Variant="Variant.Filled" Underline="false" Class="app-field" InputMode="InputMode.numeric"
                     Label="@T.Get(Copy.BudgetToLabel)"
                     Error="@(Problem is not null)" ErrorText="@ProblemText" />
</MudStack>
