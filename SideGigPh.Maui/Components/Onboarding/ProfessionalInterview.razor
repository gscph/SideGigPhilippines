@page "/start/pro/{Step:int?}"

@if (_finishing is not null)
{
    <WorkingLoader Steps="SettingUpSteps" OnDone="GoHomeAsync" />
}
else if (_state is not null)
{
    switch (_step)
    {
        case ProStep.Skills:
            <InterviewStep Illustration="🛠️" Title="@T.Get(Copy.ProSkillsTitle)" Why="@T.Get(Copy.ProSkillsWhy)" Progress="Progress"
                           OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Categories, T)"
                             SelectedIds="Selected(Draft.CategoryId)" OnPick="PickSkillAsync" />
            </InterviewStep>
            break;

        case ProStep.Services:
            <InterviewStep Illustration="✅" Title="@T.Get(Copy.ProServicesTitle)" Why="@T.Get(Copy.ProServicesWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.ServiceIds.Count > 0)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.ServicesByCategory[Draft.CategoryId!], T)" Multiple="true"
                             SelectedIds="Draft.ServiceIds" OnPick="ToggleService" />
            </InterviewStep>
            break;

        case ProStep.Area:
            <InterviewStep Illustration="🗺️" Title="@T.Get(Copy.ProAreaTitle)" Why="@T.Get(Copy.ProAreaWhy)" Note="@T.Get(Copy.CitiesNote)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Areas, T)"
                             SelectedIds="Selected(Draft.AreaId)" OnPick="PickAreaAsync" />
            </InterviewStep>
            break;

        case ProStep.Towns:
            <InterviewStep Illustration="📍" Title="@T.Get(Copy.ProAreasTitle)" Why="@T.Get(Copy.ProAreasWhy)"
                           Progress="Progress" OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.CityIds.Count > 0)">
                <TownPicker AreaId="@(Draft.AreaId!)" Multiple="true" SelectedIds="Draft.CityIds"
                            OnPick="ToggleCity" OnPickAll="ToggleWholeArea" />
            </InterviewStep>
            break;

        case ProStep.Experience:
            <InterviewStep Illustration="🏅" Title="@T.Get(Copy.ProExperienceTitle)" Why="@T.Get(Copy.ProExperienceWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Experience, T)"
                             SelectedIds="Selected(Draft.ExperienceId)" OnPick="PickExperienceAsync" />
            </InterviewStep>
            break;

        case ProStep.Rate:
            <InterviewStep Illustration="💵" Title="@T.Get(Copy.ProRateTitle)" Why="@T.Get(Copy.ProRateWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.RateOptions, T)"
                             SelectedIds="Selected(Draft.RateTierId)" OnPick="PickRateAsync" />
            </InterviewStep>
            break;

        case ProStep.Goal:
            @* No auto-advance here: the payoff under the tiles is the reward for answering. *@
            <InterviewStep Illustration="🎯" Title="@T.Get(Copy.ProGoalTitle)" Why="@T.Get(Copy.ProGoalWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.IncomeGoalId is not null)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.IncomeGoals, T)" Compact="true"
                             SelectedIds="Selected(Draft.IncomeGoalId)" OnPick="PickGoal" />
                <GoalPayoff RateTierId="@Draft.RateTierId" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;

        case ProStep.Preview:
            <InterviewStep Illustration="👀" Title="@T.Get(Copy.ProPreviewTitle)" Why="@T.Get(Copy.ProPreviewWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="Finish" NextLabel="@T.Get(Copy.ProPreviewConfirm)">
                <ListingPreview Listing="Draft.ToListing()" />
                <GoalPayoff RateTierId="@Draft.RateTierId" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;
    }
}
