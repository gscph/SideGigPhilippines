@page "/start/pro/{Step:int?}"

@if (_state is not null)
{
    switch (_step)
    {
        case ProStep.Skills:
            <InterviewStep Title="@T.Get(Copy.ProSkillsTitle)" Why="@T.Get(Copy.ProSkillsWhy)" Progress="Progress"
                           OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Categories, T)"
                             SelectedIds="Selected(Draft.CategoryId)" OnPick="PickSkillAsync" />
            </InterviewStep>
            break;

        case ProStep.Services:
            <InterviewStep Title="@T.Get(Copy.ProServicesTitle)" Why="@T.Get(Copy.ProServicesWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.ServiceIds.Count > 0)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.ServicesByCategory[Draft.CategoryId!], T)" Multiple="true"
                             SelectedIds="Draft.ServiceIds" OnPick="ToggleService" />
            </InterviewStep>
            break;

        case ProStep.Area:
            <InterviewStep Title="@T.Get(Copy.ProAreaTitle)" Why="@T.Get(Copy.ProAreaWhy)" Note="@T.Get(Copy.CitiesNote)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Areas, T)"
                             SelectedIds="Selected(Draft.AreaId)" OnPick="PickAreaAsync" />
            </InterviewStep>
            break;

        case ProStep.Towns:
            <InterviewStep Title="@T.Get(Copy.ProAreasTitle)" Why="@T.Get(Copy.ProAreasWhy)"
                           Progress="Progress" OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.CityIds.Count > 0)">
                <TownPicker AreaId="@(Draft.AreaId!)" Multiple="true" SelectedIds="Draft.CityIds"
                            OnPick="ToggleCity" OnPickAll="ToggleWholeArea" />
            </InterviewStep>
            break;

        case ProStep.Experience:
            <InterviewStep Title="@T.Get(Copy.ProExperienceTitle)" Why="@T.Get(Copy.ProExperienceWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Experience, T)"
                             SelectedIds="Selected(Draft.ExperienceId)" OnPick="PickExperienceAsync" />
            </InterviewStep>
            break;

        case ProStep.Rate:
            <InterviewStep Title="@T.Get(Copy.ProRateTitle)" Why="@T.Get(Copy.ProRateWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.RateOptions, T)"
                             SelectedIds="Selected(Draft.RateTierId)" OnPick="PickRateAsync" />
            </InterviewStep>
            break;

        case ProStep.Goal:
            @* No auto-advance here: the payoff under the tiles is the reward for answering. *@
            <InterviewStep Title="@T.Get(Copy.ProGoalTitle)" Why="@T.Get(Copy.ProGoalWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.IncomeGoalId is not null)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.IncomeGoals, T)" Compact="true"
                             SelectedIds="Selected(Draft.IncomeGoalId)" OnPick="PickGoal" />
                <GoalPayoff RateTierId="@Draft.RateTierId" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;

        case ProStep.Contact:
            <InterviewStep Title="@T.Get(Copy.ProNameTitle)" Why="@T.Get(Copy.ProNameWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="SaveContactAsync" CanContinue="@(IsContactValid)">
                <MudStack Spacing="3">
                    <MudTextField T="string" @bind-Value="_name" Immediate="true" Variant="Variant.Outlined" MaxLength="60"
                                  Placeholder="@T.Get(Copy.ProNamePlaceholder)" autocomplete="name"
                                  aria-label="@T.Get(Copy.ProNameTitle)" />
                    <MudTextField T="string" @bind-Value="_phone" Immediate="true" Variant="Variant.Outlined" MaxLength="16"
                                  InputType="InputType.Telephone" InputMode="InputMode.tel" Placeholder="0917 123 4567"
                                  Error="_phoneInvalid" ErrorText="@T.Get(Copy.ProPhoneInvalid)" autocomplete="tel"
                                  aria-label="@T.Get(Copy.ProPhoneTitle)" />
                </MudStack>
            </InterviewStep>
            break;

        case ProStep.Preview:
            <InterviewStep Title="@T.Get(Copy.ProPreviewTitle)" Why="@T.Get(Copy.ProPreviewWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="FinishAsync" NextLabel="@T.Get(Copy.ProPreviewConfirm)">
                <ListingPreview Listing="Draft.ToListing()" />
                <GoalPayoff RateTierId="@Draft.RateTierId" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;
    }
}
