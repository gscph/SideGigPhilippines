@page "/start/pro/{Step:int?}"

@if (_state is not null)
{
    switch (_step)
    {
        case ProStep.Skills:
            <InterviewStep Illustration="@AppImages.Trade" Title="@T.Get(Copy.ProSkillsTitle)" Why="@T.Get(Copy.ProSkillsWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="OtherTradeNext" CanContinue="@(!string.IsNullOrWhiteSpace(_otherTradeText))">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.TradeChoices, T)"
                             SelectedIds="Selected(_pickedOtherTrade ? ReferenceData.OtherTradeId : Draft.CategoryId)" OnPick="PickSkillAsync" />
                @if (_pickedOtherTrade)
                {
                    <OtherJobField Label="@T.Get(Copy.OtherTradeProLabel)" Help="@T.Get(Copy.OtherTradeHelp)"
                                   Value="@_otherTradeText" ValueChanged="SetOtherTradeText" />
                }
            </InterviewStep>
            break;

        case ProStep.Services:
            <InterviewStep Illustration="@AppImages.Jobs" Title="@T.Get(Copy.ProServicesTitle)" Why="@T.Get(Copy.ProServicesWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.ServiceIds.Count > 0)">
                <JobPicker CategoryId="@Draft.CategoryId" SelectedIds="Draft.ServiceIds" AllSelected="@Draft.HasAllJobs()"
                           OnPick="ToggleService" OnPickAll="ToggleAllJobs" />
                @if (Draft.ServiceIds.Any(ReferenceData.IsOtherJob))
                {
                    <OtherJobField Label="@T.Get(Copy.OtherJobProLabel)" Value="@Draft.OtherJobText" ValueChanged="SetOtherJobText" />
                }
            </InterviewStep>
            break;

        case ProStep.Towns:
            <InterviewStep Illustration="@AppImages.Town" Title="@T.Get(Copy.ProAreasTitle)" Why="@T.Get(Copy.ProAreasWhy)" Note="@T.Get(Copy.CitiesNote)"
                           Progress="Progress" OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.CityIds.Count > 0)">
                <TownPicker Multiple="true" SelectedIds="Draft.CityIds"
                            OnPick="ToggleCity" OnPickAll="ToggleAllTowns" />
            </InterviewStep>
            break;

        case ProStep.Experience:
            <InterviewStep Illustration="@AppImages.Experience" Title="@T.Get(Copy.ProExperienceTitle)" Why="@T.Get(Copy.ProExperienceWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Experience, T)"
                             SelectedIds="Selected(Draft.ExperienceId)" OnPick="PickExperienceAsync" />
            </InterviewStep>
            break;

        case ProStep.Rate:
            <InterviewStep Illustration="@AppImages.Price" Title="@T.Get(Copy.ProRateTitle)" Why="@T.Get(Copy.ProRateWhy)"
                           Progress="Progress" OnBack="GoBack"
                           OnNext="SaveRateAsync" CanContinue="@CanSaveRate">
                <RatePriceField @bind-Value="_rate" ServiceIds="Draft.ServiceIds" />
            </InterviewStep>
            break;

        case ProStep.Photo:
            @* One thing to do: a selfie. The camera (and its permission prompt) opens only on a tap, after the reason is read;
               the question moves on once it's saved. Next shows only for a photo they already have (coming back to this question). *@
            <InterviewStep Illustration="@AppImages.Selfie" Title="@T.Get(Copy.SetupPhoto)" Why="@(Draft.HasProof ? null : T.Get(Copy.SelfieWhy))" Progress="Progress"
                           OnBack="GoBack" OnNext="PhotoNext">
                <SelfieField OnSaved="AdvanceAsync" />
            </InterviewStep>
            break;

        case ProStep.Number:
            <InterviewStep Illustration="@AppImages.Number" Title="@T.Get(_codeSent ? CommonCopy.AuthCodeTitle : CommonCopy.AuthPhoneTitle)"
                           Why="@(_codeSent ? null : T.Get(Copy.ProNumberWhy))" Progress="Progress" OnBack="NumberBackAsync">
                <NumberField @ref="_number" OnLinked="NumberLinkedAsync" OnLater="AdvanceAsync" SentToChanged="CodeSent" />
            </InterviewStep>
            break;

        case ProStep.Preview:
            <InterviewStep Illustration="@AppImages.Preview" Title="@T.Get(Copy.ProPreviewTitle)" Why="@T.Get(Copy.ProPreviewWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="FinishAsync" NextLabel="@T.Get(Copy.ProPreviewConfirm)">
                <ListingPreview Listing="Workspace.Listing" />
            </InterviewStep>
            break;
    }
}
