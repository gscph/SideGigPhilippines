@page "/start/pro/{Step:int?}"

@if (_state is not null)
{
    switch (_step)
    {
        case ProStep.Skills when _otherTradeNoted:
            <OtherTradeThanks Message="@T.Get(Copy.OtherTradeProThanks)" Progress="Progress" OnPickAnother="PickAnotherTrade" />
            break;

        case ProStep.Skills:
            <InterviewStep Illustration="🛠️" Title="@T.Get(Copy.ProSkillsTitle)" Why="@T.Get(Copy.ProSkillsWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="OtherTradeNext" CanContinue="@(!string.IsNullOrWhiteSpace(_otherTradeText))">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.TradeChoices, T)"
                             SelectedIds="Selected(_pickedOtherTrade ? ReferenceData.OtherTradeId : Draft.CategoryId)" OnPick="PickSkillAsync" />
                @if (_pickedOtherTrade)
                {
                    <OtherJobField Label="@T.Get(Copy.OtherTradeProLabel)" Help="@T.Get(Copy.OtherTradeHelp)"
                                   Value="@_otherTradeText" ValueChanged="SetOtherTradeText" />
                }
            </InterviewStep>
            break;

        case ProStep.Services:
            <InterviewStep Illustration="✅" Title="@T.Get(Copy.ProServicesTitle)" Why="@T.Get(Copy.ProServicesWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.ServiceIds.Count > 0)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.ServicesOf(Draft.CategoryId), T)" Multiple="true"
                             SelectedIds="Draft.ServiceIds" OnPick="ToggleService" />
                @if (Draft.ServiceIds.Any(ReferenceData.IsOtherJob))
                {
                    <OtherJobField Label="@T.Get(Copy.OtherJobProLabel)" Value="@Draft.OtherJobText" ValueChanged="SetOtherJobText" />
                }
            </InterviewStep>
            break;

        case ProStep.Towns:
            <InterviewStep Illustration="📍" Title="@T.Get(Copy.ProAreasTitle)" Why="@T.Get(Copy.ProAreasWhy)" Note="@T.Get(Copy.CitiesNote)"
                           Progress="Progress" OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.CityIds.Count > 0)">
                <TownPicker Multiple="true" SelectedIds="Draft.CityIds"
                            OnPick="ToggleCity" OnPickAll="ToggleAllTowns" />
            </InterviewStep>
            break;

        case ProStep.Experience:
            <InterviewStep Illustration="🏅" Title="@T.Get(Copy.ProExperienceTitle)" Why="@T.Get(Copy.ProExperienceWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Experience, T)"
                             SelectedIds="Selected(Draft.ExperienceId)" OnPick="PickExperienceAsync" />
            </InterviewStep>
            break;

        case ProStep.Rate:
            <InterviewStep Illustration="💵" Title="@T.Get(Copy.ProRateTitle)" Why="@T.Get(Copy.ProRateWhy)"
                           Note="@T.Format(Copy.ProRateNote, Money.Peso(ReferenceData.MinimumWage))" Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(Pricing.RateChoices(Draft.ServiceIds), T)"
                             SelectedIds="Selected(Draft.RateTierId)" OnPick="PickRateAsync" />
            </InterviewStep>
            break;

        case ProStep.Goal:
            @* No auto-advance here: the payoff under the tiles is the reward for answering. *@
            <InterviewStep Illustration="🎯" Title="@T.Get(Copy.ProGoalTitle)" Why="@T.Get(Copy.ProGoalWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="AdvanceAsync" CanContinue="@(Draft.IncomeGoalId is not null)">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.IncomeGoals, T)" Compact="true"
                             SelectedIds="Selected(Draft.IncomeGoalId)" OnPick="PickGoal" />
                <GoalPayoff RateTierId="@Draft.RateTierId" ServiceIds="Draft.ServiceIds" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;

        case ProStep.Preview:
            <InterviewStep Illustration="👀" Title="@T.Get(Copy.ProPreviewTitle)" Why="@T.Get(Copy.ProPreviewWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="FinishAsync" NextLabel="@T.Get(Copy.ProPreviewConfirm)">
                <ListingPreview Listing="Draft.ToListing()" />
                <GoalPayoff RateTierId="@Draft.RateTierId" ServiceIds="Draft.ServiceIds" IncomeGoalId="@Draft.IncomeGoalId" />
            </InterviewStep>
            break;
    }
}
