@using MobileAppTheme.Components.Auth

<MudStack Spacing="3">
    <PhoneSignIn @ref="_phone" LinkToCurrentUser="true" OnAuthenticated="HandleLinkedAsync" SentToChanged="SentToChangedAsync" />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@_error</MudAlert>
    }

    @if (_phoneInUse)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" Size="Size.Large" FullWidth="true" Disabled="_busy" OnClick="SignInWithNumberAsync">
            @T.Get(CommonCopy.AuthSignInWithNumber)
        </MudButton>
    }

    <MudButton Variant="Variant.Text" Class="app-link-button" Disabled="_busy" OnClick="OnLater">@T.Get(CommonCopy.AuthLater)</MudButton>
</MudStack>
