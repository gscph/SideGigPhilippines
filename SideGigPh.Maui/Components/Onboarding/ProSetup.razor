@page "/start/pro/setup/{Step:int?}"
@using SideGigPh.Maui.Components.Professional

@if (_loaded)
{
    switch (_step)
    {
        case ProSetupStep.Photo:
            @* One thing to do here: a selfie. It opens by itself the first time, and the step moves on once it's saved;
               Next shows only for a photo they already have (coming back to this step). *@
            <InterviewStep Illustration="@AppImages.Selfie" Title="@T.Get(Copy.SetupPhoto)" Why="@T.Get(Copy.SelfieWhy)" Progress="Progress"
                           OnBack="GoBack" OnNext="PhotoNext">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <PersonAvatar Name="@(Draft.DisplayName ?? string.Empty)" PhotoUrl="@Workspace.ProfilePhotoUrl" Size="Size.Large" />
                    <MudButton Variant="@(Draft.HasProfilePhoto ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" Size="Size.Large"
                               FullWidth="true" StartIcon="@Icons.Material.Rounded.PhotoCamera" Disabled="_busy" OnClick="TakeSelfieAsync">
                        @T.Get(Draft.HasProfilePhoto ? Copy.SelfieRetake : Copy.SelfieTake)
                    </MudButton>
                    <MudButton Variant="Variant.Text" Class="app-link-button" StartIcon="@Icons.Material.Rounded.PhotoLibrary"
                               Disabled="_busy" OnClick="ChoosePhotoAsync">
                        @T.Get(Copy.SelfieFromPhotos)
                    </MudButton>
                    <PhotoAddNotice Result="_photoResult" />
                </MudStack>
            </InterviewStep>
            break;

        case ProSetupStep.WorkPhotos:
            <InterviewStep Illustration="@AppImages.WorkPhotos" Title="@T.Get(Copy.SetupWork)"
                           Why="@T.Format(Copy.PhotosWhy, ProfessionalDraft.MinWorkPhotos, ProWorkspace.MaxWorkPhotos)" Progress="Progress"
                           OnBack="GoBack" OnNext="Next" CanContinue="@Draft.HasEnoughWorkPhotos">
                <WorkPhotosEditor OnChanged="StateHasChanged" />
            </InterviewStep>
            break;
    }
}
