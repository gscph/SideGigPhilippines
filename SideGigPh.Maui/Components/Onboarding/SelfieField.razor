<MudStack AlignItems="AlignItems.Center" Spacing="3">
    @if (Workspace.Draft.HasProfilePhoto)
    {
        <PersonAvatar Name="@(Workspace.Draft.DisplayName ?? string.Empty)" PhotoUrl="@Workspace.ProfilePhotoUrl" Size="Size.Large" />
    }
    <SelfieGuide ShowPicture="@(!Workspace.Draft.HasProfilePhoto)" />
    <MudButton Variant="@(Workspace.Draft.HasProfilePhoto ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" Size="Size.Large"
               FullWidth="true" StartIcon="@Icons.Material.Rounded.PhotoCamera" Disabled="_busy" OnClick="TakeSelfieAsync">
        @T.Get(Workspace.Draft.HasProfilePhoto ? Copy.SelfieRetake : Copy.SelfieTake)
    </MudButton>
    <PhotoAddNotice Result="_photoResult" Selfie="true" />
    @if (_unsent is not null)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Rounded.Refresh" Disabled="_busy" OnClick="RetryAsync">
            @T.Get(CommonCopy.TryAgain)
        </MudButton>
    }
</MudStack>
