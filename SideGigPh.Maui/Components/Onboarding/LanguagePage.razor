@page "/start"

@* Shown before we know the user's language, so it speaks both. *@
<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack HtmlTag="section" Justify="Justify.Center" Spacing="8" Class="full-screen px-6 pt-8 pb-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Brand.LogoIcon" Color="Color.Primary" Class="brand-logo" aria-hidden="true" />
            <MudText Typo="Typo.subtitle1" Align="Align.Center">@Brand.Name</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">Choose your language</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">Pumili ng wika</MudText>
        </MudStack>

        <ChoiceTiles Items="Options" OnPick="PickAsync" />
    </MudStack>
</MudContainer>
