@page "/start"

@* Shown before we know the user's language, so it speaks both. *@
<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudStack HtmlTag="section" Justify="Justify.Center" Spacing="8" Class="full-screen py-8">
        <BrandMark />

        <MudStack Spacing="1">
            <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">Choose your language</MudText>            
        </MudStack>

        <ChoiceTiles Items="Options" OnPick="PickAsync" />
    </MudStack>
</MudContainer>
