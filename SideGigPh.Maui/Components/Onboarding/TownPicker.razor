<MudStack Spacing="4">
    @if (Multiple)
    {
        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Text" Class="app-link-button" OnClick="() => OnPickAll.InvokeAsync()">
                @T.Get(AllSelected ? Copy.RemoveAll : Copy.SelectAll)
            </MudButton>
        </MudStack>
    }

    <ChoiceTiles Items="Tiles" Multiple="Multiple" Compact="true" SelectedIds="SelectedIds" OnPick="OnPick" />
</MudStack>
