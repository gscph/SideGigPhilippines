@* The pro's own card shown the way a customer meets it: inside a search list.
   Grey skeletons stand in for other pros; we never show invented competitors. *@
<div class="preview">
    <div class="preview__search"><span aria-hidden="true">🔍</span> @SearchText</div>
    <div class="preview__ghost" aria-hidden="true"><span></span><span></span></div>
    <div class="preview__mine">
        <ProCard Listing="Listing" />
    </div>
    <div class="preview__ghost" aria-hidden="true"><span></span><span></span></div>
</div>
