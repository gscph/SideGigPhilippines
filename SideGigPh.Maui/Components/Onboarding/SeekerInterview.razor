@page "/start/seeker/{Step:int?}"

@if (_state is not null)
{
    switch (_step)
    {
        case SeekerStep.Category:
            <InterviewStep Illustration="@AppImages.HomeRepair" Title="@T.Get(Copy.SeekerCategoryTitle)" Progress="Progress" OnBack="GoBack"
                           OnNext="OtherTradeNext" CanContinue="@HasOtherTradeText">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.TradeChoices, T)"
                             SelectedIds="Selected(_pickedOtherTrade ? ReferenceData.OtherTradeId : Answers.CategoryId)" OnPick="PickCategoryAsync" />
                @if (_pickedOtherTrade)
                {
                    <OtherJobField Label="@T.Get(Copy.OtherTradeSeekerLabel)" Help="@T.Get(Copy.OtherTradeHelp)"
                                   Value="@_otherTradeText" ValueChanged="SetOtherTradeText" />
                }
            </InterviewStep>
            break;

        case SeekerStep.Service:
            <InterviewStep Illustration="@AppImages.Job" Title="@T.Get(Copy.SeekerServiceTitle)" Why="@T.Get(Copy.SeekerServiceWhy)"
                           Progress="Progress" OnBack="GoBack" OnNext="OtherJobNext">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.ServicesOf(Answers.CategoryId), T)"
                             SelectedIds="Selected(Answers.ServiceId)" OnPick="PickServiceAsync" />
                @if (PickedOtherJob)
                {
                    <OtherJobField Label="@T.Get(Copy.OtherJobSeekerLabel)" Value="@Answers.OtherJobText" ValueChanged="SetOtherJobText" />
                }
            </InterviewStep>
            break;

        case SeekerStep.City:
            <InterviewStep Illustration="@AppImages.Town" Title="@T.Get(Copy.SeekerCityTitle)" Why="@T.Get(Copy.SeekerCityWhy)" Note="@T.Get(Copy.CitiesNote)"
                           Progress="Progress" OnBack="GoBack">
                <TownPicker SelectedIds="Selected(Answers.CityId)" OnPick="PickCityAsync" />
            </InterviewStep>
            break;

        case SeekerStep.When:
            <InterviewStep Illustration="@AppImages.When" Title="@T.Get(Copy.SeekerWhenTitle)" Why="@T.Get(Copy.SeekerWhenWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.Urgencies, T)"
                             SelectedIds="Selected(Answers.UrgencyId)" OnPick="PickWhenAsync" />
            </InterviewStep>
            break;

        case SeekerStep.Budget:
            <InterviewStep Illustration="@AppImages.Budget" Title="@T.Get(Copy.SeekerBudgetTitle)" Why="@BudgetWhy" Note="@T.Get(Copy.SeekerBudgetWhy)"
                           Progress="Progress" OnBack="GoBack" OnNext="SaveBudgetAsync" CanContinue="@Pricing.IsValidBudget(_budgetMin, _budgetMax)">
                <ChoiceTiles Items="ChoiceItem.From(BudgetChoices, T)" SelectedIds="Selected(PickedBudget)" OnPick="PickBudgetAsync" />
                <MudText Typo="Typo.subtitle2">@T.Get(Copy.BudgetOwnRange)</MudText>
                <BudgetRangeFields @bind-Min="_budgetMin" @bind-Max="_budgetMax" />
            </InterviewStep>
            break;

        case SeekerStep.FindBy:
            <InterviewStep Illustration="@AppImages.FindBy" Title="@T.Get(Copy.SeekerFindByTitle)" Why="@T.Get(Copy.SeekerFindByWhy)"
                           Progress="Progress" OnBack="GoBack">
                <ChoiceTiles Items="ChoiceItem.From(ReferenceData.FindByChoices, T)"
                             SelectedIds="Selected(Answers.FindBy)" OnPick="PickFindByAsync" />
            </InterviewStep>
            break;

        case SeekerStep.Finding:
            @* Nothing of its own: the brand splash (BusyOverlay) covers it while the answers are saved. *@
            break;
    }
}
