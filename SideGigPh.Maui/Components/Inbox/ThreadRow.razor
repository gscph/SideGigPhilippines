<MudLink Href="@SeekerRoutes.Thread(Thread.Pro.Id)" Underline="Underline.None" Color="Color.Inherit">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="py-3">
        <PersonAvatar Name="@Thread.Pro.DisplayName" PhotoUrl="@Thread.Pro.PhotoUrl" />
        <MudStack Spacing="0" Class="flex-1 overflow-hidden">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                <MudText Typo="Typo.subtitle2" Class="one-line">@Thread.Pro.DisplayName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-shrink-0">@T.Ago(Thread.Latest.At)</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@Preview</MudText>
        </MudStack>
    </MudStack>
</MudLink>
