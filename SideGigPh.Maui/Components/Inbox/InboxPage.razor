@page "/inbox"
@layout SeekerLayout

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.InboxTitle)</MudText>

    @if (Workspace.Threads.Count == 0)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-8">
            <EmptyState Icon="@Icons.Material.Outlined.ChatBubbleOutline" Text="@T.Get(Copy.InboxEmpty)" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Rounded.Search" Href="@SeekerRoutes.Search">
                @T.Get(Copy.SearchTitle)
            </MudButton>
        </MudStack>
    }

    <MudStack Spacing="0">
        @foreach (var thread in Workspace.Threads)
        {
            <SeekerChatRow Thread="thread" @key="thread.Chat.Id" />
            <MudDivider />
        }
    </MudStack>
    <LoadMoreOnScroll HasMore="Workspace.HasMoreThreads" OnLoadMore="Workspace.MoreThreadsAsync" />
</MudStack>
