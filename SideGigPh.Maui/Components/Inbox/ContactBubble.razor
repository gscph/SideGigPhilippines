<MudPaper Elevation="0" MaxWidth="85%" Class="pa-3 rounded-lg align-self-end mud-primary-hover">
    <MudStack Spacing="1">
        @if (Contact.Channel == InquiryChannel.Call)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                <MudText Typo="Typo.body2">@T.Get(Copy.YouCalled)</MudText>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body2">@Contact.Message</MudText>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.End">@Caption</MudText>
    </MudStack>
</MudPaper>
