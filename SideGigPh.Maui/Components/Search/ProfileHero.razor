<MudStack AlignItems="AlignItems.Center" Spacing="1" Class="@(OnCover ? null : "pt-2")">
    <PersonAvatar Name="@Listing.DisplayName" PhotoUrl="@Listing.PhotoUrl" Class="@PhotoClass" />
    <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">@Listing.DisplayName</MudText>
    @if (TradeIn.Length > 0)
    {
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-1">@TradeIn</MudText>
    }
    @if (AlsoGoesTo is { } also)
    {
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">@also</MudText>
    }
</MudStack>
