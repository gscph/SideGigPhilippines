<MudStack AlignItems="AlignItems.Center" Spacing="1">
    <PersonAvatar Name="@Listing.DisplayName" PhotoUrl="@Listing.PhotoUrl" Class="profile-photo" />
    <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">@Listing.DisplayName</MudText>
    <TradeBadge Listing="Listing" Size="Size.Medium" Justify="Justify.Center" />
    @if (T.Towns(Listing) is { Length: > 0 } towns)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Dark" aria-hidden="true" />
            <MudText Typo="Typo.body2">@T.Format(Copy.ProProfileGoesTo, towns)</MudText>
        </MudStack>
    }
</MudStack>
