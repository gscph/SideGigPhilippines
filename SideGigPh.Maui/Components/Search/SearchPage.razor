@page "/seeker/search"
@layout SeekerLayout

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="app-visually-hidden">@T.Get(Copy.SearchTitle)</MudText>
    <SearchSummaryPill Request="Request" UrgencyId="@Workspace.Answers.UrgencyId" Words="@Workspace.Answers.SearchText" />

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <FilterMenu Icon="@Icons.Material.Filled.Payments" Label="@T.Get(Copy.FilterBudget)" Options="Budgets"
                    SelectedId="@Request.BudgetId" OnPick="PickBudgetAsync" />
        <FilterMenu Icon="@Icons.Material.Filled.Sort" Label="@T.Get(Copy.FilterSort)" Options="Orders"
                    SelectedId="@Request.Order.ToString()" OnPick="PickOrderAsync" />
    </MudStack>

    @if (Request.CategoryId is null)
    {
        <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.BrowseTitle)</MudText>
        <ChoiceTiles Items="CategoryItems" OnPick="PickCategoryAsync" />
    }
    else if (_result is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        @if (_suggestedCategoryIds.Count > 0)
        {
            @* Words that matched no trade searched "Others"; the trades they came close to are one tap away. *@
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.SearchOrPickTrade)</MudText>
            <ChoiceTiles Items="CategoryItems" Compact="true" OnPick="PickCategoryAsync" />
        }

        @if (_result.Total == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Text="@T.FormatHonorific(Copy.ResultsEmpty, Honorifics.For(Request.CategoryId), englishPlural: true)" OnRetry="RunSearchAsync" />
            @if (Network.IsOnline)
            {
                @* Nobody yet for this job (a new trade, a small town): posting lets workers nearby send their price. *@
                <PostRequestCard />
            }
        }

        <ResultGroup Title="@T.InTownHeading(_result.InTownTotal, TownLabel)" Hits="_result.InTown" Request="Request" />
        <ResultGroup Title="@T.NearbyHeading(_result.OtherTownsTotal, _result.InTownTotal, TownLabel)" Hits="_result.OtherTowns" Request="Request" />
        <LoadMoreOnScroll HasMore="_result.HasMore" OnLoadMore="LoadMoreAsync" @key="_searchVersion" />
    }
</MudStack>
