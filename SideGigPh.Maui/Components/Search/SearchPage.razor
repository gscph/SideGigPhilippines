@page "/seeker/search"
@layout SeekerLayout

<MudStack Spacing="3">
    
    <SearchBox Value="@Workspace.Answers.SearchText" CategoryId="@Request.CategoryId" Live="true" OnSearch="SearchForAsync" />   

    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <FilterMenu Icon="@Icons.Material.Filled.Place" Label="@T.Get(Copy.FilterTown)" Options="Towns"
                    SelectedId="@Request.CityId" OnPick="PickTownAsync" />
        <FilterMenu Icon="@Icons.Material.Filled.Payments" Label="@T.Get(Copy.FilterBudget)" Options="Budgets"
                    SelectedId="@Request.BudgetId" OnPick="PickBudgetAsync" />
        <FilterMenu Icon="@Icons.Material.Filled.Schedule" Label="@T.Get(Copy.FilterWhen)" Options="Urgencies"
                    SelectedId="@Workspace.Answers.UrgencyId" OnPick="PickUrgencyAsync" />
    </MudStack>

    @if (Request.CategoryId is null || _unmatchedText is not null)
    {
        <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.BrowseTitle)</MudText>
        <ChoiceTiles Items="CategoryItems" OnPick="PickCategoryAsync" />
    }
    else if (_result is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </MudStack>
    }
    else
    {
        @if (_result.Total > 0 || Network.IsOnline)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" role="status">@Summary</MudText>
        }

        @if (_result.Total == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Text="@T.FormatHonorific(Copy.ResultsEmpty, Honorifics.For(Request.CategoryId), englishPlural: true)" OnRetry="RunSearchAsync" />
            @if (Network.IsOnline)
            {
                @* Nobody yet for this job (a new trade, a small town): posting lets workers nearby send their price. *@
                <PostRequestCard />
            }
        }
        else if (_result.InTownTotal == 0)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true">@T.Format(Copy.ResultsWidened, TownLabel)</MudAlert>
        }

        <ResultGroup Title="@T.Format(Copy.ResultsInTown, TownLabel)" Hits="_result.InTown" Total="_result.InTownTotal" />
        <ResultGroup Title="@T.Get(Copy.ResultsOtherTowns)" Hits="_result.OtherTowns" Total="_result.OtherTownsTotal" />
        <LoadMoreOnScroll HasMore="_result.HasMore" OnLoadMore="LoadMoreAsync" @key="_searchVersion" />
    }
</MudStack>
