@page "/pro/{Id}"
@layout SeekerLayout

<MudStack Spacing="6">
    @if (HasCover)
    {
        <MudStack Spacing="0">
            <ProfileCover ProId="@Id" Photos="_pro!.WorkPhotoUrls">
                <ProfileActions BackHref="@BackHref" ReportHref="@ReportHref" OnPhoto="true" />
            </ProfileCover>
            <MudStack Spacing="5" Class="profile-sheet">
                <ProfileHero Listing="_pro" SeekerTownId="@Workspace.Request.CityId" OnCover="true" />
                <ProfileStatRow Listing="_pro" Reviews="@ProfileFacts.Summary(_reviews)" />
            </MudStack>
        </MudStack>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <ProfileActions BackHref="@BackHref" ReportHref="@ReportHref" />
        </MudStack>
    }

    @if (_loading)
    {
        @* The brand splash (BusyOverlay) covers a slow load. *@
    }
    else if (_pro is null)
    {
        <MudText Typo="Typo.h5" HtmlTag="h1">@T.Get(Copy.ProNotFoundTitle)</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@T.Get(Copy.ProNotFound)</MudText>
    }
    else
    {
        @if (!HasCover)
        {
            <MudStack Spacing="5">
                <ProfileHero Listing="_pro" SeekerTownId="@Workspace.Request.CityId" />
                <ProfileStatRow Listing="_pro" Reviews="@ProfileFacts.Summary(_reviews)" />
            </MudStack>
        }
        <MudDivider />
        <ProfileTrust Listing="_pro" />
        <MudDivider />
        <JobList Listing="_pro" />

        <MudDivider />
        <ReviewStrip Reviews="_reviews" AllHref="@SeekerRoutes.ProReviews(_pro.Id)" />

        <ProfileFooter Listing="_pro" ContactHref="@SeekerRoutes.Thread(_pro.Id)" />
    }
</MudStack>
