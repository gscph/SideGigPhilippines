@page "/pro/{Id}"
@layout SeekerLayout

<MudStack Spacing="5">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@SeekerRoutes.BackOrSearch(Back)" aria-label="@T.Get(CommonCopy.Back)" />
        @if (_pro is not null && _pro.Id != Workspace.MyId)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Color="Color.Dark" aria-label="@T.Get(Copy.ReportButton)"
                           Href="@SeekerRoutes.Report(_pro.Id, ReportSubject.Listing, SeekerRoutes.Pro(_pro.Id))" />
        }
    </MudStack>

    @if (_loading)
    {
        @* The brand splash (BusyOverlay) covers a slow load. *@
    }
    else if (_pro is null)
    {
        <MudText Typo="Typo.h5" HtmlTag="h1">@T.Get(Copy.ProNotFoundTitle)</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@T.Get(Copy.ProNotFound)</MudText>
    }
    else
    {
        <ProfileHero Listing="_pro" />
        <ProfileStats Listing="_pro" Reviews="Summary" />
        <ProfileTrust Listing="_pro" />
        <JobList Listing="_pro" />

        @if (_pro.WorkPhotoUrls.Count > 0)
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" HtmlTag="h2">@T.Get(Copy.ProProfilePhotos)</MudText>
                <PhotoStrip Label="@T.Get(Copy.ProProfilePhotos)">
                    @foreach (var url in _pro.WorkPhotoUrls)
                    {
                        <MudImage Src="@url" Alt="" ObjectFit="ObjectFit.Cover" Class="work-thumb rounded-lg" role="listitem" @key="url" />
                    }
                </PhotoStrip>
            </MudStack>
        }

        <MudStack Spacing="2">
            <MudText Typo="Typo.h6" HtmlTag="h2">@T.Get(Copy.ReviewsTitle)</MudText>
            @if (_reviews.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProProfileNoReviews)</MudText>
            }
            else
            {
                <RatingSummary Reviews="_reviews" />
                <MudStack Spacing="0">
                    @foreach (var review in _reviews)
                    {
                        <ReviewRow Review="review" ReportHref="@ReviewReportHref(review)" />
                        <MudDivider />
                    }
                </MudStack>
            }
        </MudStack>

        <MudPaper Elevation="0" Square="true" Class="app-sticky-action py-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Forum" Href="@SeekerRoutes.Thread(_pro.Id)">
                @T.Get(Copy.ContactPro)
            </MudButton>
        </MudPaper>
    }
</MudStack>
