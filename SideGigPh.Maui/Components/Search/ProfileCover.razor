<MudStack Spacing="0" Class="profile-cover">
    <MudStack Row="true" Spacing="0" Class="profile-cover-strip overflow-x-auto flex-nowrap" role="list" aria-label="@T.Get(Copy.ProProfilePhotos)">
        @for (var i = 0; i < Photos.Count; i++)
        {
            var index = i;
            var url = Photos[index];
            <MudLink Href="@SeekerRoutes.ProPhotos(ProId, index)" role="listitem" Class="profile-cover-photo" @key="url"
                     aria-label="@T.Format(Copy.WorkPhotoOpen, index + 1, Photos.Count)">
                <MudImage Src="@url" Alt="" ObjectFit="ObjectFit.Cover" Class="mud-width-full mud-height-full" />
            </MudLink>
        }
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="profile-cover-actions">
        @ChildContent
    </MudStack>
</MudStack>
