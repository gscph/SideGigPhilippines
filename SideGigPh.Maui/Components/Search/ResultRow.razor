<MudLink Href="@SeekerRoutes.Pro(Hit.Pro.Id)" Underline="Underline.None" Color="Color.Inherit" Class="d-block">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="py-4 border-b border-solid mud-border-lines-default" role="listitem">
        <PersonAvatar Name="@Hit.Pro.DisplayName" PhotoUrl="@Hit.Pro.PhotoUrl" Class="result-thumb flex-shrink-0" />
        <MudStack Spacing="0" Class="flex-1 app-min-w-0">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="one-line flex-1 app-min-w-0">@WhatAndWhere</MudText>
                <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Class="flex-shrink-0">
                    @if (Hit.Reviews is { Count: > 0 })
                    {
                        <MudIcon Icon="@Icons.Material.Rounded.Star" Color="Color.Warning" Size="Size.Small" aria-hidden="true" />
                    }
                    <MudText Typo="Typo.body2">@Stars</MudText>
                </MudStack>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@Hit.Pro.DisplayName</MudText>
            @if (Facts is { } facts)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@facts</MudText>
            }
            @if (Price is { } price)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Baseline" Class="mt-1">
                    <MudText Typo="Typo.subtitle1" Color="Color.Success">@price</MudText>
                    <MudText Typo="Typo.body2">@T.Get(Copy.ResultPerService)</MudText>
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.subtitle1" Class="mt-1">@T.Get(Copy.RateQuote)</MudText>
            }
            @if (Hit.FitsBudget)
            {
                <MudChip T="string" Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" Class="ma-0 mt-2 align-self-start">
                    @T.Get(Copy.FitsBudget)
                </MudChip>
            }
        </MudStack>
    </MudStack>
</MudLink>
