<MudStack Spacing="4">
    @if (Summary is null)
    {
        <MudText Typo="Typo.h5" HtmlTag="h2">@T.Get(Copy.ProProfileNoReviews)</MudText>
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Rounded.Star" Color="Color.Warning" aria-hidden="true" />
            <MudText Typo="Typo.h5" HtmlTag="h2">@Heading</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start" Class="overflow-x-auto flex-nowrap" role="list">
            @foreach (var review in InRow)
            {
                <ReviewCard Review="review" @key="review.Id" />
            }
        </MudStack>
        <MudButton Variant="Variant.Text" Color="Color.Dark" FullWidth="true" Size="Size.Large"
                   Class="mud-background-gray" Href="@AllHref">
            @ShowAll
        </MudButton>
    }
</MudStack>
