<MudTextField T="string" @bind-Value="_text" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-pill-input app-search-pill" Immediate
              DebounceInterval="@(Live ? 400 : 0)" OnDebounceIntervalElapsed="OnTypedAsync" OnKeyDown="OnKeyDownAsync"
              Clearable="true" OnClearButtonClick="ClearAsync"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Dark"
              Placeholder="@T.FormatHonorific(Copy.SearchPlaceholder, Honorific)" MaxLength="80"
              InputMode="InputMode.search"  />
