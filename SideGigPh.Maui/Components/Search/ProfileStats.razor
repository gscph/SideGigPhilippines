<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Stretch" role="list">
    @if (Reviews is { } reviews)
    {
        <StatTile Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning" Value="@Average(reviews)"
                  Caption="@(reviews.Count == 1 ? T.Get(Copy.StatOneReview) : T.Format(Copy.StatReviews, reviews.Count))" />
    }
    else
    {
        <StatTile Icon="@Icons.Material.Filled.StarBorder" IconColor="Color.Warning"
                  Value="@T.Get(Copy.StatNew)" Caption="@T.Get(Copy.StatNoReviews)" />
    }

    @if (T.ExperienceLabel(Listing) is { } experience)
    {
        @if (Listing.IsSeasoned())
        {
            <StatTile Icon="@Icons.Material.Filled.WorkspacePremium" IconColor="Color.Primary" Highlight="true"
                      Value="@experience" Caption="@T.Get(Copy.StatExperience)" />
        }
        else
        {
            <StatTile Icon="@Icons.Material.Filled.Handyman" Value="@experience" Caption="@T.Get(Copy.StatExperience)" />
        }
    }

    @if (T.RateLabel(Listing) is { } rate)
    {
        <StatTile Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success" Value="@rate" Caption="@T.Get(Copy.StatPerJob)" />
    }
    else
    {
        <StatTile Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success"
                  Value="@T.Get(Copy.StatAskPrice)" Caption="@T.Get(Copy.StatPriceDepends)" />
    }
</MudStack>
