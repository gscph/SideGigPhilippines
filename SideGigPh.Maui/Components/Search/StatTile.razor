<MudPaper Outlined="true" Class="flex-1 app-rounded app-min-w-0 pa-3" role="listitem">
    <MudStack AlignItems="AlignItems.Center" Spacing="0">
        <MudIcon Icon="@Icon" Color="IconColor" aria-hidden="true" />
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="@(Highlight ? IconColor : Color.Default)">@Value</MudText>
        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">@Caption</MudText>
    </MudStack>
</MudPaper>
