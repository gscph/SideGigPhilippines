@page "/search"

<MudContainer MaxWidth="MaxWidth.Small" Class="pt-4 pb-8">
    <MudStack HtmlTag="section" Spacing="4">
        <MudStack HtmlTag="header" Spacing="2">
            <MudText Typo="Typo.h5" HtmlTag="h1">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ResultsEditHint)</MudText>
            <AnswerChips Items="_chips" OnEdit="EditStep" />
        </MudStack>

        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </MudStack>
        }
        else
        {
            @if (_widenedFromTown is not null)
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@T.Format(Copy.ResultsWidened, _widenedFromTown)</MudAlert>
            }

            @if (_results.Count == 0)
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="py-8">@T.Get(Copy.ResultsEmpty)</MudText>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
            }

            <MudStack Spacing="3">
                @foreach (var pro in _results)
                {
                    <ProCard Listing="pro" Highlight="@(FitsBudget(pro) ? T.Get(Copy.FitsBudget) : null)">
                        <Actions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Phone" OnClick="() => CallAsync(pro)">
                                @T.Get(Copy.Call)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Sms" OnClick="() => TextAsync(pro)">
                                @T.Get(Copy.Text)
                            </MudButton>
                        </Actions>
                    </ProCard>
                }
            </MudStack>
        }
    </MudStack>
</MudContainer>
