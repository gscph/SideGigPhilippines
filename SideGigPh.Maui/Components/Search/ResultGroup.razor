@if (Hits.Count > 0)
{
    <MudStack HtmlTag="section" Spacing="0">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="pt-2">@Title</MudText>
        <MudStack Spacing="0" role="list">
            @foreach (var hit in Hits)
            {
                <ResultRow Hit="hit" Request="Request" @key="hit.Pro.Id" />
            }
        </MudStack>
    </MudStack>
}
