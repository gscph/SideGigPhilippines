@if (Jobs.Count > 0)
{
    <MudStack Spacing="4">
        <MudText Typo="Typo.h5" HtmlTag="h2">@T.Format(Copy.ProfileDoes, ProfileFacts.FirstName(Listing.DisplayName))</MudText>
        <MudStack Spacing="3" role="list">
            @foreach (var job in Jobs)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" role="listitem" @key="job.Id">
                    <MudImage Src="@AppImages.For(job.Id)" Alt="" Width="40" Height="40" Class="flex-shrink-0" />
                    <MudText Typo="Typo.body1">@job.Label</MudText>
                </MudStack>
            }
        </MudStack>
    </MudStack>
}
