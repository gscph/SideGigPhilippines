@if (Labels.Count > 0)
{
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" HtmlTag="h2">@T.Get(Copy.ProProfileJobs)</MudText>
        <MudPaper Outlined="true" Class="app-rounded px-4 py-1">
            <MudStack Spacing="0" role="list">
                @for (var i = 0; i < Labels.Count; i++)
                {
                    var label = Labels[i];
                    @if (i > 0)
                    {
                        <MudDivider />
                    }
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="py-3" role="listitem" @key="label">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" aria-hidden="true" />
                        <MudText Typo="Typo.body1">@label</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
}
