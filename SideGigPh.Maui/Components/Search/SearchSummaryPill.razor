<MudButton Variant="Variant.Outlined" Color="Color.Dark" FullWidth="true" Href="@Href" Class="rounded-pill app-raised py-2 px-5">
    <MudStack Spacing="0" AlignItems="AlignItems.Center" Class="mud-width-full app-min-w-0">
        <MudText Typo="Typo.subtitle1" Class="one-line">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@Note</MudText>
    </MudStack>
</MudButton>
