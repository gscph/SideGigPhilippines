<MudStack Row="true" AlignItems="AlignItems.Start" Spacing="4" role="listitem">
    <MudIcon Icon="@Icon" Color="Color.Dark" Size="Size.Large" aria-hidden="true" />
    <MudStack Spacing="0" Class="flex-1 app-min-w-0">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        @if (!string.IsNullOrEmpty(Note))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Note</MudText>
        }
    </MudStack>
</MudStack>
