<MudStack Spacing="4">
    <MudText Typo="Typo.h5" HtmlTag="h2">@T.Get(Copy.ProProfileTrust)</MudText>
    <MudStack Spacing="4" role="list">
        @foreach (var badge in Listing.BadgesToShow(MaxBadges).Shown)
        {
            <TrustRow Icon="@BadgeIcons.Of(badge.Kind)" Title="@T.Badge(badge)" Note="@T.BadgeNote(badge)" />
        }
        <TrustRow Icon="@Icons.Material.Outlined.Smartphone" Title="@T.Get(Copy.TrustPhone)" Note="@T.Get(Copy.TrustPhoneNote)" />
    </MudStack>
</MudStack>
