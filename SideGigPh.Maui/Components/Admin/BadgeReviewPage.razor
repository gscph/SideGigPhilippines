@page "/admin/badges"

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack Spacing="0" Class="full-screen">
        <SheetHeader OnBack="GoBack" Divider="false" />

        <MudStack Spacing="4" Class="flex-1 px-6 pt-2 pb-16">
            <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.AdminBadgesTitle)</MudText>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!_allowed)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Lock" Text="@T.Get(Copy.AdminNotOperator)" />
            }
            else if (Review.Pending.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Rounded.FactCheck" Text="@T.Get(Copy.AdminNothingWaiting)" />
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.AdminBadgesWhy)</MudText>
                @foreach (var request in Review.Pending)
                {
                    <PendingBadgeCard Request="request" @key="request.Id" OnDecided="StateHasChanged" />
                }
            }
        </MudStack>
    </MudStack>
</MudContainer>
