<MudPaper Outlined="true" Elevation="0" Class="app-rounded pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@(Job.IsCompleted ? Icons.Material.Rounded.Verified : Icons.Material.Rounded.Handshake)"
                     Color="@(Job.IsCompleted ? Color.Success : Color.Dark)" aria-hidden="true" />
            <MudStack Spacing="0" Class="flex-1 app-min-w-0">
                <MudText Typo="Typo.subtitle1">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@ServiceLabel · @Money.Peso(Job.PricePesos)</MudText>
            </MudStack>
        </MudStack>

        <MudText Typo="Typo.body2">@Status</MudText>

        @if (BlindNote is { } note)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@note</MudText>
        }

        @if (!Job.DoneByMe)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy"
                       StartIcon="@Icons.Material.Rounded.TaskAlt" OnClick="MarkDoneAsync">
                @T.Get(Copy.MarkDone)
            </MudButton>
        }
        else if (Job.IsCompleted && Job.MyReviewLocked)
        {
            @if (!Job.IAmTheHousehold && Job.MyRating is { } locked)
            {
                <MudText Typo="Typo.body2">@T.Format(Copy.YouRatedCustomer, locked)</MudText>
            }
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ReviewLockedNote)</MudText>
        }
        else if (Job.IsCompleted && Job.IAmTheHousehold && RateHref is not null)
        {
            <MudButton Variant="Variant.Outlined" Class="app-button-ink" FullWidth="true" Href="@RateHref"
                       StartIcon="@Icons.Material.Rounded.StarOutline">
                @T.Get(Job.MyRating is null ? Copy.LeaveReview : Copy.ChangeReview)
            </MudButton>
        }
        else if (Job.IsCompleted && !Job.IAmTheHousehold)
        {
            @if (Job.MyRating is { } given && !_editing)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Class="flex-1">@T.Format(Copy.YouRatedCustomer, given)</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Dark" OnClick="Edit">@T.Get(Copy.ChangeRating)</MudButton>
                </MudStack>
            }
            else
            {
                <MudText Typo="Typo.subtitle2">@T.Get(Copy.RateCustomerLabel)</MudText>
                <MudRating @bind-SelectedValue="_stars" Color="Color.Warning" Size="Size.Large" aria-label="@T.Get(Copy.RateCustomerLabel)" />
                <MudTextField @bind-Value="_comment" Variant="Variant.Filled" Class="app-field" Lines="2" MaxLength="1000"
                              Label="@T.Get(Copy.RateCustomerComment)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(_busy || _stars == 0)" OnClick="RateAsync">
                    @T.Get(Copy.RateCustomerSend)
                </MudButton>
            }
        }

        @if (PickCancel.CanCancel(Job))
        {
            @if (!_cancelling)
            {
                <MudStack Row="true">
                    <MudButton Variant="Variant.Text" Class="app-link-button" Disabled="_busy" OnClick="StartCancel">
                        @T.Get(Copy.CancelPickLink)
                    </MudButton>
                </MudStack>
            }
            else
            {
                <MudDivider />
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@T.Get(Copy.CancelPickTitle)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Job.IAmTheHousehold ? Copy.CancelPickHousehold : Copy.CancelPickWorker)</MudText>
                </MudStack>
                <MudRadioGroup T="string" @bind-Value="_reason" Disabled="_busy">
                    @foreach (var reason in PickCancel.ReasonsFor(Job.IAmTheHousehold))
                    {
                        <MudRadio T="string" Value="reason" Color="Color.Dark" LabelPlacement="Placement.Start" Class="app-choice-radio py-1" @key="reason">
                            @T.CancelReason(reason)
                        </MudRadio>
                    }
                </MudRadioGroup>
                <MudTextField T="string" @bind-Value="_note" Immediate="true" Disabled="_busy" Variant="Variant.Filled" Underline="false"
                              Class="app-field" Lines="2" MaxLength="@PickCancel.MaxNote" Label="@T.Get(Copy.CancelPickNote)" />
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Class="app-button-ink flex-1" Disabled="_busy" OnClick="KeepIt">
                        @T.Get(Copy.CancelPickKeep)
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Class="flex-1"
                               Disabled="@(_busy || !PickCancel.IsReady(Job.IAmTheHousehold, _reason, _note))" OnClick="CancelAsync">
                        @T.Get(Copy.CancelPickConfirm)
                    </MudButton>
                </MudStack>
            }
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@_error</MudAlert>
        }
    </MudStack>
</MudPaper>
