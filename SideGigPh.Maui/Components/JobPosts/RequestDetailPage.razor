@page "/professional/requests/{Id:long}"
@using SideGigPh.Maui.Components.Professional
@layout ProLayout

<MudStack Spacing="4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@ProRoutes.Requests" aria-label="@T.Get(CommonCopy.Back)" />
        @if (_item is { CanOffer: true } && !_reported)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Color="Color.Dark" Disabled="_busy"
                           OnClick="ReportAsync" aria-label="@T.Get(Copy.PostReport)" />
        }
    </MudStack>

    @if (!_loaded)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Text" Height="48px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="88px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
        </MudStack>
    }
    else if (_item is null)
    {
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" HtmlTag="h1" Align="Align.Center">@T.Get(Copy.RequestGone)</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ProRoutes.Requests">@T.Get(Copy.RequestSeeAll)</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4" HtmlTag="h1" Align="Align.Center">@T.ServiceLabel(_item.Post)</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">@T.RequestPlace(_item.Post)</MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Stretch" role="list">
            <StatTile Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success" Highlight="true"
                      Value="@Pricing.PostBudget(_item.Post)" Caption="@T.Get(Copy.RequestStatBudget)" />
            @if (_item.Post.HouseholdStars is { } stars)
            {
                <StatTile Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning"
                          Value="@RequestText.StarsValue(stars)" Caption="@T.Get(Copy.RequestStatStars)" />
            }
            <StatTile Icon="@Icons.Material.Outlined.Schedule" Value="@T.Ago(_item.Post.CreatedAt)" Caption="@T.Get(Copy.RequestStatPosted)" />
        </MudStack>

        @if (_notice is not null)
        {
            <MudAlert Severity="@(_noticeIsError ? Severity.Error : Severity.Success)" Variant="Variant.Text" Dense="true" role="status">@T.Get(_notice)</MudAlert>
        }

        <MudDivider />

        <MudStack Spacing="4">
            @if (_item.Post.OffersService)
            {
                <RequestHighlight Icon="@Icons.Material.Rounded.CheckCircle" IconColor="Color.Success"
                                  Title="@T.Get(Copy.RequestOffersService)" Detail="@T.Get(Copy.RequestOffersServiceWhy)" />
            }
            <RequestHighlight Icon="@Icons.Material.Outlined.ChatBubbleOutline" Title="@T.Get(Copy.RequestTheyWrote)" Detail="@_item.Post.Description" />
            @if (_item.MyNote is { } note)
            {
                <RequestHighlight Icon="@Icons.Material.Outlined.StickyNote2" Title="@T.Get(Copy.RequestYourNote)" Detail="@note" />
            }
        </MudStack>

        @if (_item.Post.PhotoUrls.Count > 0)
        {
            <PhotoStrip Label="@T.Get(Copy.PostPhotosLabel)">
                @foreach (var url in _item.Post.PhotoUrls)
                {
                    <PhotoTile Url="@url" CanRemove="false" @key="url" />
                }
            </PhotoStrip>
        }

        @if (!_reported)
        {
            <MudPaper Elevation="0" Square="true" Class="app-sticky-action py-2">
                @if (_offering && _item.CanOffer)
                {
                    <OfferBox Item="_item" Busy="_busy" OnSend="SendTypedAsync" OnCancel="CloseOfferBox" />
                }
                else
                {
                    <RequestActionBar Item="_item" Busy="_busy" OnTake="TakeBudgetAsync" OnOtherPrice="OpenOfferBox" OnWithdraw="WithdrawAsync" />
                }
            </MudPaper>
        }
    }
</MudStack>
