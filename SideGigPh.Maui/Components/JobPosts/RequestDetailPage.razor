@page "/professional/requests/{Id:long}"
@using SideGigPh.Maui.Components.Professional

<MudContainer MaxWidth="MaxWidth.Small" Gutters="false">
    <MudStack Spacing="0" Class="full-screen">
        <SheetHeader OnClose="Close" Divider="false">
            <Actions>
                @if (_item is { CanOffer: true } && !_reported)
                {
                    <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Color="Color.Dark" Disabled="_busy"
                                   OnClick="ReportAsync" aria-label="@T.Get(Copy.PostReport)" />
                }
            </Actions>
        </SheetHeader>

        <MudStack Spacing="5" Class="flex-1 px-6 pt-2 pb-16">
            @if (!_loaded)
            {
                <MudStack Spacing="3">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Height="48px" Width="60%" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" Class="rounded-lg" />
                </MudStack>
            }
            else if (_item is null)
            {
                <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.RequestGone)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="@ProRoutes.Requests">@T.Get(Copy.RequestSeeAll)</MudButton>
            }
            else
            {
                <MudText Typo="Typo.h4" HtmlTag="h1">@T.RequestPageTitle(_item)</MudText>

                @if (_notice is not null)
                {
                    <MudAlert Severity="@(_noticeIsError ? Severity.Error : Severity.Success)" Variant="Variant.Text" Dense="true" role="status">@T.Get(_notice)</MudAlert>
                }

                <MudPaper Outlined="true" Elevation="0" Class="app-rounded px-4">
                    <RequestSummary Post="_item.Post" />
                    @if (_item.HasMyOffer)
                    {
                        <MudDivider />
                        @if (_editing)
                        {
                            <MudStack Class="py-4">
                                <OfferFields @bind-Price="_price" @bind-Note="_note" Busy="_busy" />
                            </MudStack>
                        }
                        else
                        {
                            <DetailRow Label="@T.Get(Copy.OfferYourPrice)" Value="@Money.Peso(_item.MyPricePesos ?? 0)" ValueColor="Color.Success"
                                       Detail="@T.RequestOfferDetail(_item)"
                                       ActionLabel="@(_item.CanOffer ? T.Get(Copy.RequestChange) : null)" OnAction="StartEditing" Busy="_busy" />
                        }
                    }
                    <MudDivider />
                    <DetailRow Label="@T.Get(Copy.RequestTheirBudget)" Value="@Pricing.PostBudget(_item.Post)" ValueColor="Color.Success" />
                    <MudDivider />
                    <DetailRow Label="@T.Get(Copy.RequestTheyNeed)" Value="@_item.Post.Description">
                        @if (_item.Post.PhotoUrls.Count > 0)
                        {
                            <MudStack Class="request-photos pt-2">
                                <PhotoStrip Label="@T.Get(Copy.PostPhotosLabel)">
                                    @foreach (var url in _item.Post.PhotoUrls)
                                    {
                                        <PhotoTile Url="@url" CanRemove="false" @key="url" />
                                    }
                                </PhotoStrip>
                            </MudStack>
                        }
                    </DetailRow>
                </MudPaper>

                @if (_item.State == RequestState.New)
                {
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@T.Get(Copy.OfferYourPrice)</MudText>
                        <PriceChoice BudgetPesos="_item.Post.BudgetPesos" @bind-OtherPrice="_otherPrice"
                                     @bind-Price="_price" @bind-Note="_note" Busy="_busy" />
                    </MudStack>
                }
                else if (_item.State == RequestState.Offered && !_editing)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Dark" Class="app-link-button align-self-center" Disabled="_busy" OnClick="WithdrawAsync">
                        @T.Get(Copy.RequestTakeBack)
                    </MudButton>
                }
            }
        </MudStack>

        @if (_item is not null && !_reported)
        {
            <RequestFooter Item="_item" Editing="_editing" Busy="_busy" CanSend="CanSend"
                           OnSend="SendAsync" OnCancel="StopEditing" />
        }
    </MudStack>
</MudContainer>
