@using SideGigPh.Maui.Components.Professional
<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
    @switch (Item.State)
    {
        case RequestState.New:
            <MudStack Spacing="0" AlignItems="AlignItems.Start" Class="app-min-w-0">
                <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="one-line">@Pricing.PostBudget(Item.Post)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T.Get(Copy.RequestTheirBudget)</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="app-link-button" Disabled="Busy" OnClick="OnOtherPrice">
                    @T.Get(Copy.OfferOtherPrice)
                </MudButton>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="flex-shrink-0" Disabled="Busy" OnClick="OnTake">
                @T.Get(Copy.RequestTakeIt)
            </MudButton>
            break;

        case RequestState.Offered:
            <MudStack Spacing="0" Class="app-min-w-0">
                <MudText Typo="Typo.subtitle1" Color="Color.Success" Class="one-line">@T.Format(Copy.OfferMine, Money.Peso(Item.MyPricePesos ?? 0))</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T.Get(Copy.RequestWaiting)</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-shrink-0">
                <MudButton Variant="Variant.Text" Color="Color.Dark" Disabled="Busy" OnClick="OnWithdraw">@T.Get(Copy.OfferWithdraw)</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Dark" Disabled="Busy" OnClick="OnOtherPrice">@T.Get(Copy.RequestChange)</MudButton>
            </MudStack>
            break;

        case RequestState.Picked:
            <MudText Typo="Typo.subtitle1" Color="Color.Success">@T.Get(Copy.MyOfferPicked)</MudText>
            @if (Item.ChatId is { } chatId)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Rounded.ChatBubbleOutline"
                           Href="@ProRoutes.Chat(chatId)">
                    @T.Get(Copy.PostOpenChat)
                </MudButton>
            }
            break;

        default:
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@T.Get(Copy.MyOfferNotPicked)</MudText>
            break;
    }
</MudStack>
