<MudLink Href="@JobPostRoutes.Request(Item.Post.Id)" Underline="Underline.None" Color="Color.Inherit" Class="d-block py-3">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <PostThumb PhotoUrl="@Item.Post.PhotoUrls.FirstOrDefault()" Fallback="@AppImages.For(Item.Post.ServiceId)" />
        <MudStack Spacing="0" Class="flex-1 app-min-w-0">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1" Class="one-line">@T.ServiceLabel(Item.Post)</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Success" Class="flex-shrink-0">@Pricing.PostBudget(Item.Post)</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@T.RequestPlace(Item.Post)</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="one-line">@T.RequestTimeLine(Item)</MudText>
                <MudChip T="string" Size="Size.Small" Class="ma-0 flex-shrink-0"
                         Color="@(Item.HasMyOffer ? Color.Dark : Color.Primary)"
                         Variant="@(Item.HasMyOffer ? Variant.Outlined : Variant.Filled)">
                    @T.RequestAction(Item)
                </MudChip>
            </MudStack>
        </MudStack>
    </MudStack>
</MudLink>
