<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
    <MudIcon Icon="@Icon" Color="IconColor" aria-hidden="true" />
    <MudStack Spacing="0" Class="flex-1 app-min-w-0">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Detail))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Detail</MudText>
        }
    </MudStack>
</MudStack>
