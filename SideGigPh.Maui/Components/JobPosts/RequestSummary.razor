<MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="py-4">
    <PostThumb PhotoUrl="@Post.PhotoUrls.FirstOrDefault()" Fallback="@AppImages.For(Post.ServiceId)" />
    <MudStack Spacing="0" Class="flex-1 app-min-w-0">
        <MudText Typo="Typo.h6">@T.ServiceLabel(Post)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.RequestPlace(Post)</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            @if (Post.HouseholdStars is not null)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" aria-hidden="true" />
            }
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.RequestMeta(Post)</MudText>
        </MudStack>
    </MudStack>
</MudStack>
