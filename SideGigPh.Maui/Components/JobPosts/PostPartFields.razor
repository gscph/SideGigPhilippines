@switch (Part)
{
    case PostPart.What when JobsStep:
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.PostService)</MudText>
            <ChoiceTiles Items="ServiceTiles" SelectedIds="@Selected(Draft.ServiceId)" Compact="true" OnPick="PickServiceAsync" />
        </MudStack>
        break;
    case PostPart.What:
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.PostTrade)</MudText>
            <ChoiceTiles Items="TradeTiles" SelectedIds="@Selected(Draft.CategoryId)" Compact="true" OnPick="PickTradeAsync" />
        </MudStack>
        break;
    case PostPart.Where:
        <MudStack Spacing="2" Class="app-field-group">
            <MudSelect T="string" Value="Draft.CityId" ValueChanged="PickTown" Variant="Variant.Filled" Underline="false"
                       Label="@T.Get(Copy.FilterTown)" Class="app-field">
                @foreach (var town in ReferenceData.Cities)
                {
                    <MudSelectItem T="string" Value="@town.Id">@T.Get(town.Label)</MudSelectItem>
                }
            </MudSelect>
            <BarangayField TownId="@Draft.CityId" @bind-Value="Draft.BarangayId" />
        </MudStack>
        <LocationButton IsSet="@(Draft.Point is not null)" Why="@T.Get(Copy.PostLocationWhy)" OnFound="@(point => Draft.Point = point)" />
        break;
    case PostPart.When:
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.PostWhenWhy)</MudText>
        <MudDatePicker PickerVariant="PickerVariant.Static" Date="PickedDate" DateChanged="PickDay" MinDate="FirstDate" MaxDate="LastDate"
                       ShowToolbar="false" Elevation="0" Color="Color.Primary" Class="align-self-center" aria-label="@T.Get(Copy.PostSheetWhen)" />
        <MudButton Variant="@(Draft.NeededOn is null ? Variant.Filled : Variant.Outlined)" Color="@(Draft.NeededOn is null ? Color.Primary : Color.Dark)"
                   FullWidth="true" StartIcon="@Icons.Material.Filled.EventAvailable" OnClick="AnyDay">
            @T.Get(Copy.PostAnyDayButton)
        </MudButton>
        break;
    default:
        <MudStack Spacing="2" Class="app-field-group">
            <MudNumericField T="int?" @bind-Value="Draft.BudgetMinPesos" Immediate="true" Variant="Variant.Filled" Underline="false"
                             Class="app-field" HideSpinButtons="true" Min="0" Adornment="Adornment.Start" AdornmentText="₱"
                             Label="@T.Get(Copy.PostBudgetFrom)" HelperText="@BudgetGuide" />
            <MudNumericField T="int?" @bind-Value="Draft.BudgetPesos" Immediate="true" Variant="Variant.Filled" Underline="false"
                             Class="app-field" HideSpinButtons="true" Min="0" Adornment="Adornment.Start" AdornmentText="₱"
                             Label="@T.Get(Copy.PostBudgetUpTo)" HelperText="@T.Get(Copy.PostBudgetWhy)"
                             Error="@BudgetTopTooLow" ErrorText="@T.Get(Copy.BudgetToError)" />
        </MudStack>
        break;
}
