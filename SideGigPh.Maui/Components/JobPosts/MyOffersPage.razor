@page "/professional/requests/offers"
@using SideGigPh.Maui.Components.Professional
@layout ProLayout

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.ProPostsTitle)</MudText>
    <RequestsSwitch Current="@JobPostRoutes.MyOffers" />

    @if (_offers is null)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
        </MudStack>
    }
    else if (_offers.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.LocalOffer" Text="@T.Get(Copy.MyOffersEmpty)" OnRetry="LoadAsync" />
    }
    else
    {
        <MudStack Spacing="0">
            @foreach (var offer in _offers)
            {
                <RequestRow @key="offer.Post.Id" Item="@RequestItem.From(offer)" />
                <MudDivider @key="@($"d{offer.Post.Id}")" />
            }
        </MudStack>
    }
</MudStack>
