@page "/professional/requests/offers"
@using SideGigPh.Maui.Components.Professional
@layout ProLayout

<MudStack Spacing="3">
    <MudButton Variant="Variant.Text" Class="app-link-button align-self-start" StartIcon="@Icons.Material.Rounded.ArrowBack"
               Href="@JobPostRoutes.Feed">
        @T.Get(Copy.MyOffersBack)
    </MudButton>

    <MudStack Spacing="1">
        <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.MyOffersTitle)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.MyOffersWhy)</MudText>
    </MudStack>

    @if (_offers is null)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
        </MudStack>
    }
    else if (_offers.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.LocalOffer" Text="@T.Get(Copy.MyOffersEmpty)" />
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var offer in _offers)
            {
                <MyOfferCard @key="offer.Post.Id" Offer="offer" />
            }
        </MudStack>
    }
</MudStack>
