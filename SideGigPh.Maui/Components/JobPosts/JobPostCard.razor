<MudCard Outlined="true" Elevation="0" Class="app-rounded">
    <MudCardContent Class="pa-3">
        <MudStack Spacing="2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                <MudStack Spacing="1" Class="flex-1 app-min-w-0">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2">@ServiceLabel</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                        @if (TradeLabel is not null)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="ma-0">@TradeLabel</MudChip>
                        }
                        @if (ForWorker && Post.OffersService)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Check" Class="ma-0">@T.Get(Copy.PostOffersService)</MudChip>
                        }
                        @if (!ForWorker)
                        {
                            <MudChip T="string" Color="@(Post.IsOpen ? Color.Success : Color.Default)" Variant="Variant.Text" Size="Size.Small" Class="ma-0">
                                @T.Get(Post.IsOpen ? Copy.PostShowing : Copy.PostTakenDown)
                            </MudChip>
                        }
                    </MudStack>
                </MudStack>
                @if (ForWorker)
                {
                    <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Size="Size.Small" Color="Color.Secondary"
                                   OnClick="@(() => OnReport.InvokeAsync(Post))" aria-label="@T.Get(Copy.PostReport)" />
                }
            </MudStack>

            <MudText Typo="Typo.body1">@Post.Description</MudText>

            <MudStack Spacing="1">
                <ProCardFact Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success" Highlight="true"
                             Text="@T.Format(Copy.PostBudgetFact, Money.Peso(Post.BudgetPesos))" />
                <ProCardFact Icon="@Icons.Material.Filled.Place" Text="@Where" />
            </MudStack>

            @if (Post.PhotoUrls.Count > 0)
            {
                <PhotoStrip Label="@T.Get(Copy.PostPhotosLabel)">
                    @foreach (var url in Post.PhotoUrls)
                    {
                        <PhotoTile Url="@url" CanRemove="false" @key="url" />
                    }
                </PhotoStrip>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="flex-1">@T.Ago(Post.CreatedAt)</MudText>
                @if (!ForWorker && Post.IsOpen)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="app-link-button" OnClick="@(() => OnTakeDown.InvokeAsync(Post))">
                        @T.Get(Copy.PostTakeDown)
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>
