@page "/professional/requests"
@using SideGigPh.Maui.Components.Professional
@layout ProLayout

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.ProPostsTitle)</MudText>
    <RequestsSwitch Current="@JobPostRoutes.Feed" />

    @if (!_loaded)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
        </MudStack>
    }
    else if (!Board.HasListing)
    {
        <EmptyState Icon="@Icons.Material.Outlined.VisibilityOff" Text="@T.Get(Copy.ProPostsNeedListing)" OnRetry="Board.LoadFeedAsync" />
    }
    else if (Board.Feed.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Campaign" Text="@T.Get(Copy.ProPostsEmpty)" OnRetry="Board.LoadFeedAsync" />
    }
    else
    {
        <MudStack Spacing="0">
            @foreach (var post in Board.Feed)
            {
                <RequestRow @key="post.Id" Item="@RequestItem.From(post)" />
                <MudDivider @key="@($"d{post.Id}")" />
            }
        </MudStack>
        <LoadMoreOnScroll HasMore="Board.HasMore" OnLoadMore="Board.LoadMoreFeedAsync" />
    }
</MudStack>
