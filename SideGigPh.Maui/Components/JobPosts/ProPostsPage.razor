@page "/professional/requests"
@using SideGigPh.Maui.Components.Professional
@layout ProLayout

<MudStack Spacing="3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.ProPostsTitle)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProPostsWhy)</MudText>
        <MudButton Variant="Variant.Text" Class="app-link-button align-self-start" StartIcon="@Icons.Material.Rounded.LocalOffer"
                   Href="@JobPostRoutes.MyOffers">
            @T.Get(Copy.MyOffersLink)
        </MudButton>
    </MudStack>

    @if (_notice is not null)
    {
        <MudAlert Severity="@(_noticeIsError ? Severity.Error : Severity.Success)" Variant="Variant.Text" Dense="true" role="status">@T.Get(_notice)</MudAlert>
    }

    @if (!_loaded)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
        </MudStack>
    }
    else if (!Board.HasListing)
    {
        <EmptyState Icon="@Icons.Material.Outlined.VisibilityOff" Text="@T.Get(Copy.ProPostsNeedListing)" OnRetry="Board.LoadFeedAsync" />
    }
    else if (Board.Feed.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Campaign" Text="@T.Get(Copy.ProPostsEmpty)" OnRetry="Board.LoadFeedAsync" />
    }
    else
    {
        <MudStack Spacing="3">
            @foreach (var post in Board.Feed)
            {
                <JobPostCard @key="post.Id" Post="post" ForWorker="true" OnReport="ReportAsync"
                             SendOffer="SendOfferAsync" OnWithdrawOffer="WithdrawOfferAsync" Busy="_busy" />
            }
        </MudStack>
        <LoadMoreOnScroll HasMore="Board.HasMore" OnLoadMore="Board.LoadMoreFeedAsync" />
    }
</MudStack>
