@page "/professional/profile"
@layout ProLayout

<MudStack Spacing="4">
    <MudText Typo="Typo.h5" HtmlTag="h1">@T.Get(Copy.ProfileTitle)</MudText>

    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <PersonAvatar Name="@Name" PhotoUrl="@Workspace.ProfilePhotoUrl" Class="profile-photo" />
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera"
                   Disabled="_busy" OnClick="ChangePhotoAsync">
            @T.Get(Workspace.ProfilePhotoUrl is null ? Copy.ProfilePhotoAdd : Copy.ProfilePhotoChange)
        </MudButton>
        <PhotoAddNotice Result="_photoResult" />
        <MudText Typo="Typo.h6" HtmlTag="h2" Align="Align.Center">@Name</MudText>
        <MudText Typo="Typo.body2" Color="@(Workspace.IsPublished ? Color.Success : Color.Secondary)">
            @T.Get(Workspace.IsPublished ? Copy.StatusPublished : Copy.StatusNotPublished)
        </MudText>
    </MudStack>

    <MudStack Row="true" Spacing="2" StretchItems="StretchItems.All">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Edit" Href="/start/pro/1">
            @T.Get(Copy.ProfileEdit)
        </MudButton>
        @if (!Workspace.IsPublished)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.RocketLaunch" Href="@ProRoutes.Publish">
                @T.Get(Copy.PublishConfirm)
            </MudButton>
        }
    </MudStack>

    @if (!Workspace.IsPublished)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@T.Get(Copy.ProHomeNotLive)</MudAlert>
    }

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.ProPreviewTitle)</MudText>
        <ProCard Listing="Workspace.Listing" Reviews="Workspace.ReviewSummary" />
    </MudStack>

    @if (JoinedLabel is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">@JoinedLabel</MudText>
    }
</MudStack>
