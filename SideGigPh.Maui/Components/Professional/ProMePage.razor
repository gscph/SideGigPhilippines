@page "/professional/me"
@layout ProLayout

<MePage Title="@T.Get(Copy.ProfileTitle)" StartOverWarning="@T.Get(Copy.StartOverWarning)">
    <ProfileCard Name="@Name" PhotoUrl="@Workspace.ProfilePhotoUrl">
        <ProfileLevelChip Level="Progress.Level" />
        <MudButton Variant="Variant.Text" Class="app-link-button" StartIcon="@Icons.Material.Rounded.PhotoCamera"
                   Color="@(Progress.Photo == ProfileMark.Missing ? Color.Error : Color.Default)"
                   Disabled="_busy" OnClick="ChangePhotoAsync">
            @T.Get(Workspace.ProfilePhotoUrl is null ? Copy.ProfilePhotoAdd : Copy.ProfilePhotoChange)
        </MudButton>
        <PhotoAddNotice Result="_photoResult" />
        <MudButton Variant="Variant.Text" Class="app-link-button" StartIcon="@Icons.Material.Rounded.Badge"
                   Href="@AuthRoutes.EditName(ProRoutes.Me)">
            @T.Get(Copy.ProfileNameChange)
        </MudButton>
    </ProfileCard>

    @if (!Workspace.IsPublished)
    {
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProHomeNotLive)</MudText>
            @if (Workspace.Draft.HasProof)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Href="@ProRoutes.Publish">
                    @T.Get(Copy.PublishConfirm)
                </MudButton>
            }
            else
            {
                <SetupCard HasPhoto="@(Workspace.ProfilePhotoUrl is not null)" WorkPhotoCount="@Workspace.WorkPhotos.Count"
                           HasReference="@Workspace.Draft.HasReference" HasVerifiedPhone="@Workspace.HasVerifiedPhone"
                           AddPhoneHref="@AddPhonePath" />
            }
        </MudStack>
    }

    @if (Progress.ShowBadgeNudge)
    {
        <BadgeNudgeCard BadgeCount="Progress.BadgeCount" />
    }

    <MudStack Spacing="0" Class="border-t border-solid mud-border-lines-default">
        <MenuRow Href="/start/pro/1" Icon="@Icons.Material.Rounded.Edit" Text="@T.Get(Copy.ProfileEdit)" />
        <MenuRow Href="@ProRoutes.WorkArea" Icon="@Icons.Material.Rounded.LocationOn"
                 Text="@T.Get(Copy.WorkAreaMenu)" SecondaryText="@T.Format(Copy.WorkAreaMenuHint, Workspace.Draft.RadiusKm ?? WorkArea.DefaultRadiusKm)" />
        <MenuRow Href="@ProRoutes.Photos" Icon="@Icons.Material.Rounded.PhotoLibrary"
                 Text="@T.Get(Copy.PhotosTitle)" SecondaryText="@PhotosCountLabel">
            <EndContent><ProfileMarkIcon Mark="Progress.WorkPhotos" /></EndContent>
        </MenuRow>
        <MenuRow Href="@ProRoutes.References" Icon="@Icons.Material.Rounded.VerifiedUser"
                 Text="@T.Get(Copy.ReferencesTitle)" SecondaryText="@ReferencesCountLabel">
            <EndContent><ProfileMarkIcon Mark="Progress.References" /></EndContent>
        </MenuRow>
        <MenuRow Href="@ProRoutes.Badges" Icon="@Icons.Material.Rounded.WorkspacePremium"
                 Text="@T.Get(Copy.BadgesTitle)" SecondaryText="@BadgesCountLabel">
            <EndContent><ProfileMarkIcon Mark="Progress.Badges" /></EndContent>
        </MenuRow>
        <MenuRow Href="@ProRoutes.Feedback" Icon="@Icons.Material.Rounded.Lightbulb"
                 Text="@T.Get(Copy.FeedbackMenu)" SecondaryText="@T.Get(Copy.FeedbackMenuHint)" />
        <OperatorMenuRow />
    </MudStack>

    <MudStack Spacing="3">
        <MudText Typo="Typo.h6" HtmlTag="h2">@T.Get(Copy.ProPreviewTitle)</MudText>
        <ProCard Listing="Workspace.Listing" Reviews="Workspace.ReviewSummary" />
    </MudStack>

    <ErrorReportsSwitch />

    @if (JoinedLabel is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">@JoinedLabel</MudText>
    }
</MePage>
