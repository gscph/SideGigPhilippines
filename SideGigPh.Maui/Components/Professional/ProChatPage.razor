@page "/professional/inbox/{ChatId}"
@layout ProLayout

<MudStack Spacing="4">
    @if (_chat is null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Color="Color.Dark" Href="@ProRoutes.Inbox" aria-label="@T.Get(CommonCopy.Back)" />
        </MudStack>
    }
    else
    {
        <ChatHeader BackHref="@ProRoutes.Inbox" Name="@T.SeekerName(_chat)" Detail="@T.WhatAndWhere(_chat)">
            <Actions>
                @if (_number is not null)
                {
                    <MudButton Variant="Variant.Outlined" Class="app-button-ink rounded-pill flex-shrink-0"
                               StartIcon="@Icons.Material.Rounded.Phone" Disabled="_busy" OnClick="CallAsync">
                        @T.Get(Copy.Call)
                    </MudButton>
                }
                <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Color="Color.Dark" aria-label="@T.Get(Copy.ReportButton)"
                               Href="@ProRoutes.Report(_chat.SeekerId, ReportSubject.Chat, ProRoutes.Chat(_chat.Id), _chat.Id)" />
            </Actions>
        </ChatHeader>

        @if (_number is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="px-6">@T.Get(Copy.CustomerNumberShared)</MudText>
        }

        @if (_job is not null)
        {
            <PickedJobCard Job="_job" OtherName="@T.SeekerName(_chat)" OtherUid="@_chat.SeekerId" OnChanged="@(job => _job = job)" />
        }

        @if (!string.IsNullOrEmpty(T.WhenAndBudget(_chat)))
        {
            <MudPaper Outlined="true" Elevation="0" Class="app-rounded pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Rounded.WorkOutline" Color="Color.Dark" aria-hidden="true" />
                    <MudText Typo="Typo.body2">@T.WhenAndBudget(_chat)</MudText>
                </MudStack>
            </MudPaper>
        }

        @if (_loaded)
        {
            <LoadMoreOnScroll Edge="LoadMoreEdge.Top" HasMore="_history.HasOlder" OnLoadMore="LoadOlderAsync" @key="ChatId" />
            <MudStack Spacing="3">
                @foreach (var message in _history.Messages)
                {
                    <ChatBubble Message="message" Mine="@(message.SenderId == Workspace.MyId)" @key="message.Id" />
                }
            </MudStack>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@_error</MudAlert>
        }

        <ChatComposer @bind-Message="_message" Busy="_busy" OnSend="SendAsync" />
    }
</MudStack>
