<MudPaper Outlined="true" Elevation="0" Class="pa-4 border-2 mud-border-info">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Rounded.WorkspacePremium" Color="Color.Info" aria-hidden="true" />
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="flex-1">@T.Get(Copy.BadgeNudgeTitle)</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Info">@T.Format(Copy.BadgesCount, BadgeCount, ProBadges.Kinds)</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.BadgeNudgeText)</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                   StartIcon="@Icons.Material.Rounded.TrendingUp" Href="@ProRoutes.Badges">
            @T.Get(Copy.BadgeNudgeButton)
        </MudButton>
    </MudStack>
</MudPaper>
