<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="py-3 border-b border-solid mud-border-lines-default">
    <MudIcon Icon="@Icons.Material.Rounded.VerifiedUser" Color="Color.Dark" aria-hidden="true" />
    <MudStack Spacing="0" Class="flex-1">
        <MudText Typo="Typo.subtitle2">@Reference.Name</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@PhilippineMobile.ToLocal(Reference.MobileNumber)</MudText>
    </MudStack>
    @if (CanRemove)
    {
        <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Color="Color.Dark"
                       aria-label="@T.Get(Copy.ReferenceRemove)" OnClick="@(() => OnRemove.InvokeAsync())" />
    }
</MudStack>
