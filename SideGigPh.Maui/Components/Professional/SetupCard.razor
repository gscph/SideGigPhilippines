<MudCard Outlined="true" Elevation="0" Class="border-2 mud-border-primary">
    <MudCardContent>
        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.SetupTitle)</MudText>
            <MudProgressLinear Value="Percent" Color="Color.Primary" Rounded="true" Size="Size.Small" Class="mb-2" />
            @if (IsPublished)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.SetupRepublishNote)</MudText>
            }
            <SetupStep Href="@ProRoutes.Me" Done="HasPhoto"
                       Title="@T.Get(Copy.SetupPhoto)" Why="@T.Get(Copy.SetupPhotoWhy)" />
            <SetupStep Href="@ProRoutes.References" Done="HasReference"
                       Title="@T.Get(Copy.SetupReference)" Why="@T.Get(Copy.SetupReferenceWhy)" />
            <SetupStep Href="@AddPhoneHref" Done="HasVerifiedPhone"
                       Title="@T.Get(Copy.SetupPhone)" Why="@T.Get(HasVerifiedPhone ? Copy.SetupPhoneDone : Copy.SetupPhoneWhy)" />
            @* Optional: never counted in the bar or needed for Publish, only a way to be seen more. *@
            <SetupStep Href="@ProRoutes.Photos" Done="HasWorkPhotos"
                       Title="@T.Get(Copy.SetupWork)" Why="@T.Get(Copy.SetupWorkWhy)" />
            @if (AllDone && !IsPublished)
            {
                <MudStack Spacing="2" Class="pt-2">
                    <MudText Typo="Typo.body2">@T.Get(Copy.SetupPublishReady)</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.RocketLaunch" Href="@ProRoutes.Publish">
                        @T.Get(Copy.SetupPublishButton)
                    </MudButton>
                </MudStack>
            }
        </MudStack>
    </MudCardContent>
</MudCard>
