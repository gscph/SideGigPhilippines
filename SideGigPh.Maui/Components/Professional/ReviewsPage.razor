@page "/professional/reviews"
@layout ProLayout

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.ReviewsTitle)</MudText>

    @if (Workspace.Reviews.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.StarOutline" Text="@T.Get(Copy.ReviewsEmpty)" />
    }
    else
    {
        <RatingSummary Reviews="Workspace.Reviews" />
        <MudDivider />
        <MudStack Spacing="0">
            @foreach (var review in Workspace.Reviews)
            {
                <ReviewRow Review="review" ReportHref="@ProRoutes.Report(review.SeekerId, ReportSubject.Review, ProRoutes.Reviews)" />
                <MudDivider />
            }
        </MudStack>
    }
</MudStack>
