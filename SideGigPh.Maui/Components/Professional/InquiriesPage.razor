@page "/professional/inquiries"
@layout ProLayout

<MudStack Spacing="3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h5" HtmlTag="h1">@T.Get(Copy.InquiriesTitle)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.InquiriesWhy)</MudText>
    </MudStack>

    @if (Workspace.Inquiries.Count == 0)
    {
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="py-8">@T.Get(Copy.InquiriesEmpty)</MudText>
    }

    <MudStack Spacing="0">
        @foreach (var inquiry in Workspace.Inquiries)
        {
            <InquiryRow Inquiry="inquiry" IsNew="@_newIds.Contains(inquiry.Id)" />
            <MudDivider />
        }
    </MudStack>
</MudStack>
