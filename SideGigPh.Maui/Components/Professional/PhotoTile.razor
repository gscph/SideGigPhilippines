<MudPaper Elevation="0" Class="relative overflow-hidden">
    <MudImage Src="@Url" Alt="" ObjectFit="ObjectFit.Cover" Class="work-thumb rounded-lg" />
    @if (CanRemove)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Filled" Color="Color.Dark"
                       Class="photo-remove" aria-label="@T.Get(Copy.PhotoRemove)" OnClick="@(() => OnRemove.InvokeAsync())" />
    }
</MudPaper>
