@page "/professional/inbox"
@layout ProLayout

<MudStack Spacing="3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.InboxTitle)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProInboxWhy)</MudText>
    </MudStack>

    @if (Workspace.Chats.Count == 0)
    {
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="py-8">@T.Get(Copy.ProInboxEmpty)</MudText>
    }

    <MudStack Spacing="0">
        @foreach (var chat in Workspace.Chats)
        {
            <ProChatRow Chat="chat" @key="chat.Id" />
            <MudDivider />
        }
    </MudStack>
</MudStack>
