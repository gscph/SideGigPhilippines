@page "/professional/inbox"
@layout ProLayout

<MudStack Spacing="3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.InboxTitle)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProInboxWhy)</MudText>
    </MudStack>

    @if (Workspace.Chats.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.ChatBubbleOutline" Text="@T.Get(Copy.ProInboxEmpty)" OnRetry="Workspace.RefreshActivityAsync" />
    }

    <MudStack Spacing="0">
        @foreach (var chat in Workspace.Chats)
        {
            <ProChatRow Chat="chat" @key="chat.Id" />
            <MudDivider />
        }
    </MudStack>
    <LoadMoreOnScroll HasMore="Workspace.HasMoreChats" OnLoadMore="Workspace.MoreChatsAsync" />
</MudStack>
