<MudStack Row="true" Spacing="3" Class="py-2">
    <MudAvatar Color="Color.Primary" Variant="@(IsNew ? Variant.Filled : Variant.Outlined)" aria-hidden="true">
        <MudIcon Icon="@(Inquiry.Channel == InquiryChannel.Call ? Icons.Material.Filled.Phone : Icons.Material.Filled.Sms)" />
    </MudAvatar>
    <MudStack Spacing="0" Class="flex-1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudText Typo="Typo.subtitle2">@What</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@T.Ago(Inquiry.At)</MudText>
        </MudStack>
        <MudText Typo="Typo.body2">@JobAndTown</MudText>
        @if (!string.IsNullOrEmpty(Details))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Details</MudText>
        }
        @if (!string.IsNullOrWhiteSpace(Inquiry.Message))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">“@Inquiry.Message”</MudText>
        }
        @if (IsNew)
        {
            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Class="ma-0 mt-1 align-self-start">@T.Get(Copy.New)</MudChip>
        }
    </MudStack>
</MudStack>
