@page "/professional/me/badges/{Kind}"
@layout ProLayout

<MudStack Spacing="4">
    <MudStack Row="true">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@ProRoutes.Badges" aria-label="@T.Get(CommonCopy.Back)" />
    </MudStack>

    <MudStack Spacing="2" AlignItems="AlignItems.Start">
        <MudIcon Icon="@BadgeIcons.Of(BadgeKind)" Color="Color.Primary" Size="Size.Large" aria-hidden="true" />
        <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Title)</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@T.Get(What)</MudText>
    </MudStack>

    @if (_problems is not null)
    {
        <PhotoRetakePrompt Problems="_problems" Busy="_busy" OnRetake="RetakeAsync" OnKeep="Keep" />
        @if (_problem is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">
                <MudStack Spacing="1" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.body2">@T.Get(_problem)</MudText>
                    @if (_result == BadgeSubmitResult.PhotoDenied)
                    {
                        <MudButton Variant="Variant.Text" Class="app-link-button" OnClick="Picker.OpenAppSettings">@T.Get(Copy.PhotosOpenSettings)</MudButton>
                    }
                </MudStack>
            </MudAlert>
        }
    }
    else if (!Badges.CanSend(BadgeKind))
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true" role="status">@T.Get(Copy.BadgeNothingToSend)</MudAlert>
    }
    else
    {
        <ProofPhotoGuide />

        <MudPaper Outlined="true" Class="app-rounded pa-3">
            <MudCheckBox T="bool" @bind-Value="_consent" Disabled="_busy" Color="Color.Primary"
                         Label="@T.Get(Consent)" />
        </MudPaper>

        @if (_problem is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">
                <MudStack Spacing="1" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.body2">@T.Get(_problem)</MudText>
                    @if (_result == BadgeSubmitResult.PhotoDenied)
                    {
                        <MudButton Variant="Variant.Text" Class="app-link-button" OnClick="Picker.OpenAppSettings">@T.Get(Copy.PhotosOpenSettings)</MudButton>
                    }
                </MudStack>
            </MudAlert>
        }

        <MudPaper Elevation="0" Square="true" Class="app-sticky-action py-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Material.Rounded.PhotoCamera"
                       Disabled="@(_busy || !_consent)" OnClick="SendAsync">
                @T.Get(Copy.BadgeTakePhoto)
            </MudButton>
        </MudPaper>
    }
</MudStack>
