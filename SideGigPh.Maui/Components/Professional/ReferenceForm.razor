<MudStack Spacing="3">
    <MudStack Spacing="0" Class="app-field-group">
        <MudTextField T="string" @bind-Value="_name" Immediate="true" Disabled="Busy" Variant="Variant.Filled" Underline="false"
                      Label="@T.Get(Copy.ReferenceName)" MaxLength="60" Class="app-field" autocomplete="off" />
        <MudTextField T="string" Value="@PhoneFormat.Region" ReadOnly="true" Variant="Variant.Filled" Underline="false"
                      Label="@T.Get(CommonCopy.AuthRegionLabel)" Class="app-field" />
        <MudTextField T="string" @bind-Value="_number" Immediate="true" Disabled="Busy" Variant="Variant.Filled" Underline="false"
                      Label="@T.Get(Copy.ReferenceNumber)" Placeholder="@PhoneFormat.Placeholder" Class="app-field"
                      InputType="InputType.Telephone" InputMode="InputMode.tel" autocomplete="off" />
    </MudStack>
    <MudCheckBox T="bool" @bind-Value="_agreed" Disabled="Busy" Color="Color.Primary" Label="@T.Get(Copy.ReferenceConsent)" />
    @if (Problem is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" role="alert">@Problem</MudAlert>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
               StartIcon="@Icons.Material.Rounded.PersonAdd" Disabled="@(Busy || !CanAdd)" OnClick="AddAsync">
        @T.Get(Copy.ReferenceAdd)
    </MudButton>
</MudStack>
