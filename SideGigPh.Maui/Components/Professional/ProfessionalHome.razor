@page "/professional"
@layout ProLayout

<MudStack Spacing="4">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="app-visually-hidden">@T.Get(Copy.NavHome)</MudText>

    @if (Workspace.HasUnfinishedEdit)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.body2">@T.Get(Copy.ListingEditUnfinished)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Workspace.UnfinishedEditPath">@T.Get(Copy.ListingEditFinish)</MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (!Workspace.IsPublished || !Workspace.Draft.HasProof)
    {
        <SetupCard HasPhoto="@(Workspace.ProfilePhotoUrl is not null)" WorkPhotoCount="@Workspace.WorkPhotos.Count"
                   HasVerifiedPhone="@Workspace.HasVerifiedPhone"
                   AddPhoneHref="@AddPhonePath" IsPublished="@Workspace.IsPublished" />
    }

    @if (Workspace.IsPublished)
    {
        @* The pro's daily work: find a job in Requests, then talk to the customer in Inbox. *@
        <MudStack Row="true" Spacing="3" Class="align-stretch">
            <ProWorkTile Primary="true" Href="@JobPostRoutes.Feed" Icon="@Icons.Material.Rounded.Campaign"
                         Label="@T.Get(Copy.ProPostsTitle)" Count="NewRequestCount" CountHasMore="Board.HasMore"
                         Detail="@RequestsDetail" />
            <ProWorkTile Href="@ProRoutes.Inbox" Icon="@Icons.Material.Rounded.ChatBubbleOutline"
                         Label="@T.Get(Copy.NavInbox)" Count="Workspace.UnreadCount" Detail="@InboxDetail" />
        </MudStack>

        <HomeSection Title="@T.Get(Copy.SectionNewRequests)" Href="@JobPostRoutes.Feed">
            @if (!_requestsLoaded)
            {
                <MudStack Spacing="2">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                </MudStack>
            }
            else if (Board.Feed.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProPostsEmpty)</MudText>
            }
            <MudStack Spacing="0">
                @foreach (var post in Board.Feed.Take(3))
                {
                    <RequestRow Item="@RequestItem.From(post)" @key="post.Id" />
                }
            </MudStack>
        </HomeSection>
    }

    <HomeSection Title="@T.Get(Copy.SectionMessages)" Href="@ProRoutes.Inbox">
        @if (Workspace.Chats.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProInboxEmpty)</MudText>
        }
        <MudStack Spacing="0">
            @foreach (var chat in Workspace.Chats.Take(3))
            {
                <ProChatRow Chat="chat" @key="chat.Id" />
            }
        </MudStack>
    </HomeSection>

    @* Profile reminders come after the work, once the listing is live. *@
    @if (Workspace.IsPublished && Workspace.Draft.HasProof)
    {
        @if (Progress.ShowWorkPhotosNudge)
        {
            <WorkPhotosNudgeCard />
        }
        else if (Progress.ShowBadgeNudge)
        {
            <BadgeNudgeCard BadgeCount="Progress.BadgeCount" />
        }
    }

    <HomeSection Title="@T.Get(Copy.SectionReviews)" Href="@ProRoutes.Reviews">
        @if (Workspace.Reviews.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ReviewsEmpty)</MudText>
        }
        @foreach (var review in Workspace.Reviews.Take(2))
        {
            <ReviewRow Review="review" />
        }
    </HomeSection>

</MudStack>
