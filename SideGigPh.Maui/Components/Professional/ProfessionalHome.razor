@page "/professional"

@if (_draft is not null)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="pt-4 pb-8">
        <MudStack HtmlTag="section" Spacing="4">
            <MudText Typo="Typo.h5" HtmlTag="h1">@T.Get(Copy.ProHomeTitle)</MudText>
            <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@T.Get(Copy.ProHomeNotLive)</MudAlert>

            <ProCard Listing="_draft.ToListing()" />

            @if (GoalLabel is not null)
            {
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">@T.Format(Copy.ProHomeGoal, GoalLabel)</MudText>
                    <GoalPayoff RateTierId="@_draft.RateTierId" IncomeGoalId="@_draft.IncomeGoalId" />
                </MudStack>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Edit" OnClick="Edit">
                @T.Get(Copy.ProHomeEdit)
            </MudButton>
        </MudStack>
    </MudContainer>
}
