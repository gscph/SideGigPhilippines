@page "/professional"
@layout ProLayout

<MudStack Spacing="4">  

    <PhotoAddNotice Result="_photoResult" />

    @if (!Workspace.IsPublished)
    {
        <SetupCard HasPhoto="@(Workspace.ProfilePhotoUrl is not null)" HasWorkPhotos="@(Workspace.WorkPhotos.Count > 0)" />
    }

    <HomeSection Title="@T.Get(Copy.SectionMessages)" Href="@ProRoutes.Inbox">
        @if (Workspace.Chats.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProInboxEmpty)</MudText>
        }
        <MudStack Spacing="0">
            @foreach (var chat in Workspace.Chats.Take(3))
            {
                <ProChatRow Chat="chat" @key="chat.Id" />
            }
        </MudStack>
    </HomeSection>

    <HomeSection Title="@T.Get(Copy.SectionReviews)" Href="@ProRoutes.Reviews">
        @if (Workspace.Reviews.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ReviewsEmpty)</MudText>
        }
        @foreach (var review in Workspace.Reviews.Take(2))
        {
            <ReviewRow Review="review" />
        }
    </HomeSection>

    @if (GoalLabel is not null)
    {
        <HomeSection Title="@T.Get(Copy.SectionGoal)">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body1">@T.Format(Copy.ProHomeGoal, GoalLabel)</MudText>
                <GoalPayoff RateTierId="@Workspace.Draft.RateTierId" IncomeGoalId="@Workspace.Draft.IncomeGoalId" />
            </MudStack>
        </HomeSection>
    }
</MudStack>

@if (Workspace.WorkPhotos.Count < ProWorkspace.MaxWorkPhotos)
{
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto" Class="app-fab"
            aria-label="@T.Get(Copy.PhotosAdd)" OnClick="AddPhotosAsync" />
}
