@page "/professional"
@layout ProLayout

<MudStack Spacing="4">  

    <PhotoAddNotice Result="_photoResult" />

    @if (Workspace.HasUnfinishedEdit)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">
            <MudStack Spacing="2" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.body2">@T.Get(Copy.ListingEditUnfinished)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Workspace.UnfinishedEditPath">@T.Get(Copy.ListingEditFinish)</MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (!Workspace.IsPublished || !Workspace.Draft.HasProof)
    {
        <SetupCard HasPhoto="@(Workspace.ProfilePhotoUrl is not null)" WorkPhotoCount="@Workspace.WorkPhotos.Count"
                   HasReference="@Workspace.Draft.HasReference" HasVerifiedPhone="@Workspace.HasVerifiedPhone"
                   AddPhoneHref="@AddPhonePath" IsPublished="@Workspace.IsPublished" />
    }
    else if (Progress.ShowWorkPhotosNudge)
    {
        <WorkPhotosNudgeCard />
    }
    else if (Progress.ShowBadgeNudge)
    {
        <BadgeNudgeCard BadgeCount="Progress.BadgeCount" />
    }

    <HomeSection Title="@T.Get(Copy.SectionMessages)" Href="@ProRoutes.Inbox">
        @if (Workspace.Chats.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ProInboxEmpty)</MudText>
        }
        <MudStack Spacing="0">
            @foreach (var chat in Workspace.Chats.Take(3))
            {
                <ProChatRow Chat="chat" @key="chat.Id" />
            }
        </MudStack>
    </HomeSection>

    <HomeSection Title="@T.Get(Copy.SectionReviews)" Href="@ProRoutes.Reviews">
        @if (Workspace.Reviews.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ReviewsEmpty)</MudText>
        }
        @foreach (var review in Workspace.Reviews.Take(2))
        {
            <ReviewRow Review="review" />
        }
    </HomeSection>

</MudStack>

@if (Workspace.WorkPhotos.Count < ProWorkspace.MaxWorkPhotos)
{
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto" Class="app-fab"
            aria-label="@T.Get(Copy.PhotosAdd)" Disabled="_busy" OnClick="AddPhotosAsync" />
}
