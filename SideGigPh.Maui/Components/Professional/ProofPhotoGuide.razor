<MudPaper Outlined="true" Elevation="0" Class="app-rounded pa-4">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
        <MudImage Src="@AppImages.ProofPhoto" Alt="@T.Get(Copy.BadgeGuideAlt)" Width="64" Height="64" />
        <MudStack Spacing="1" Class="flex-1">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.BadgeGuideTitle)</MudText>
            @foreach (var (icon, tip) in Tips)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                    <MudText Typo="Typo.body2">@T.Get(tip)</MudText>
                </MudStack>
            }
        </MudStack>
    </MudStack>
</MudPaper>
