<MudLink Href="@Href" Underline="Underline.None" Color="Color.Inherit" Class="flex-1 app-min-w-0 d-flex">
    <MudPaper Elevation="0" Outlined="@(!Primary)" Class="@TileClass" Style="@TileStyle">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudIcon Icon="@Icon" Size="Size.Large" Style="@IconStyle" />
                @if (Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(Primary ? Color.Surface : Color.Error)" Variant="Variant.Filled"
                             Class="ma-0 font-weight-bold">@CountLabel</MudChip>
                }
            </MudStack>
            <MudText Typo="Typo.h6" HtmlTag="h2" Style="@TextStyle">@Label</MudText>
            <MudText Typo="Typo.body2" Style="@DetailStyle">@Detail</MudText>
        </MudStack>
    </MudPaper>
</MudLink>
