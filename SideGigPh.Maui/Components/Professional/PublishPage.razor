@page "/professional/publish"

@if (_loaded)
{
    <InterviewStep Illustration="🚀" Title="@T.Get(Copy.PublishTitle)" Why="@T.Get(Copy.PublishWhy)" OnBack="GoBack"
                   OnNext="PublishAsync" NextLabel="@T.Get(Copy.PublishConfirm)" CanContinue="@(_pledged && !_busy)">
        <ProCard Listing="Workspace.Listing" Class="own-listing" />
        <MudCheckBox T="bool" @bind-Value="_pledged" Color="Color.Primary" Label="@T.Get(Copy.PublishPledge)" />
        @if (_phoneTaken)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@T.Get(Copy.PublishPhoneTaken)</MudAlert>
        }
        @if (_badReference)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">
                <MudStack Spacing="1" AlignItems="AlignItems.Start">
                    <MudText Typo="Typo.body2">@T.Get(Copy.PublishBadReference)</MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Href="@ProRoutes.References" Class="pa-0">@T.Get(Copy.PublishFixReferences)</MudButton>
                </MudStack>
            </MudAlert>
        }
        @if (_failed)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@T.Get(Copy.PublishFailed)</MudAlert>
        }
    </InterviewStep>
}
