@page "/professional/publish"

@if (_loaded)
{
    <InterviewStep Illustration="@AppImages.Promise" Title="@T.Get(Copy.CommitTitle)" Why="@T.Get(Copy.CommitWhy)" Progress="Progress"
                   OnBack="GoBack" OnNext="Next" CanContinue="@Workspace.Commitments.AllTicked">
        <MudStack Spacing="2" Class="mud-width-full">
            @foreach (var item in PublishChecklist.Items)
            {
                <CommitmentCheck @key="item.Id" Item="item" Ticked="@Workspace.Commitments.IsTicked(item.Id)"
                                 TickedChanged="@(ticked => Workspace.Commitments.Set(item.Id, ticked))" />
            }
        </MudStack>
    </InterviewStep>
}
