@if (Result is { Failed: true })
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@T.Get(Copy.PhotosFailed)</MudAlert>
}
else if (Result is { Duplicates: > 0 })
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" role="status">@T.Get(Copy.PhotosDuplicate)</MudAlert>
}
