<MudStack Spacing="3">
    @if (IsFull)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true">@T.Format(Copy.PhotosFull, ProWorkspace.MaxWorkPhotos)</MudAlert>
    }

    <PhotoAddNotice Result="_result" />

    <WorkPhotoGrid Photos="Workspace.WorkPhotos" Slots="ProWorkspace.MaxWorkPhotos" Label="@T.Get(Copy.PhotosTitle)"
                   CanRemove="Workspace.CanRemoveWorkPhoto" Disabled="_busy" OnAdd="AddAsync" OnRemove="RemoveAsync" />
</MudStack>
