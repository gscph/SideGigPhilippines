<MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" Square="true"
          Icon="@Icons.Material.Rounded.VisibilityOff" OnClick="GoToStep" Class="app-banner" role="status">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="app-min-w-0">
        <MudText Typo="Typo.body2" Truncate="true" Class="flex-1">@T.Get(Text)</MudText>
        <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" aria-hidden="true" />
    </MudStack>
</MudAlert>
