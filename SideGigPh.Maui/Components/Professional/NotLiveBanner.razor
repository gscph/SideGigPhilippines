<MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Square="true"
          Icon="@Icons.Material.Filled.VisibilityOff" OnClick="GoToSetup" Class="app-banner" role="status">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="app-min-w-0">
        <MudText Typo="Typo.body2" Truncate="true" Class="flex-1">@T.Get(OnlyNumberLeft ? Copy.NotLiveBannerNumber : Copy.NotLiveBanner)</MudText>
        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-hidden="true" />
    </MudStack>
</MudAlert>
