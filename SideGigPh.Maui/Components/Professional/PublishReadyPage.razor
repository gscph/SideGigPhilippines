@page "/professional/publish/ready"

@if (_loaded)
{
    <InterviewStep Illustration="@AppImages.Publish" Title="@T.Get(Copy.PublishTitle)" Why="@T.Get(Copy.PublishWhy)" Progress="Progress"
                   OnBack="GoBack" OnNext="PublishAsync" NextLabel="@T.Get(Copy.PublishReady)" CanContinue="@(!_busy)">
        <ProCard Listing="Workspace.Listing" Class="own-listing" />
        @if (_problem is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@T.Get(_problem)</MudAlert>
        }
        @if (_failed)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@T.Get(Copy.PublishFailed)</MudAlert>
        }
    </InterviewStep>
}
