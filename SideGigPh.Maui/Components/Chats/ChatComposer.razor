<MudPaper Elevation="0" Square="true" Class="app-chat-footer px-4 pt-3 border-t border-solid mud-border-lines-default">
    <MudStack Spacing="2">
        @if (Error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true" role="alert">@Error</MudAlert>
        }
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
            <MudTextField T="string" Value="@Message" ValueChanged="@(value => MessageChanged.InvokeAsync(value))" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" MaxLines="5" Sizing="InputSizing.Auto" MaxLength="1000"
                          Class="app-chat-input flex-1"
                          Placeholder="@T.Get(Copy.WriteAMessage)" aria-label="@T.Get(Copy.YourMessage)" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill app-chat-send flex-shrink-0"
                       Disabled="@(Busy || string.IsNullOrWhiteSpace(Message))" OnClick="@(() => OnSend.InvokeAsync())">
                @T.Get(Copy.Send)
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>
