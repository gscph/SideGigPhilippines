<MudStack HtmlTag="header" Row="true" AlignItems="AlignItems.Center" Spacing="1"
          Class="app-chat-header px-2 py-2 border-b border-solid mud-border-lines-default">
    <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Color="Color.Dark" Href="@BackHref"
                   aria-label="@T.Get(CommonCopy.Back)" />
    <MudLink Href="@ProfileHref" Underline="Underline.None" Color="Color.Inherit" Class="flex-1 overflow-hidden"
             aria-label="@ProfileLabel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <PersonAvatar Name="@Name" PhotoUrl="@PhotoUrl" />
            <MudStack Spacing="0" Class="overflow-hidden">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="overflow-hidden">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h1" Class="one-line">@Name</MudText>
                    @if (ProfileHref is not null)
                    {
                        <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Size="Size.Small" Color="Color.Secondary" aria-hidden="true" />
                    }
                </MudStack>
                @if (!string.IsNullOrEmpty(Detail))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@Detail</MudText>
                }
            </MudStack>
        </MudStack>
    </MudLink>
    @Actions
</MudStack>
