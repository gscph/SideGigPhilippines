@page "/seeker"
@layout SeekerLayout

<MudStack Spacing="5">
    <SearchPill />

    <CategoryRail Items="Categories" Label="@T.Get(Copy.BrowseTitle)" OnPick="PickCategoryAsync" />

    <PostRequestCard />

    @if (Workspace.RecentSearches.Count > 0)
    {
        <HomeSection Title="@T.Get(Copy.RecentSearches)">
            <MudStack Spacing="0">
                @foreach (var recent in Workspace.RecentSearches)
                {
                    <RecentSearchRow Search="recent" @key="recent" OnSearch="SearchAgainAsync" OnPost="PostAgainAsync" />
                }
            </MudStack>
        </HomeSection>
    }

    @if (Workspace.Threads.Count > 0)
    {
        <HomeSection Title="@T.Get(Copy.SectionMessages)" Href="@SeekerRoutes.Inbox">
            <MudStack Spacing="0">
                @foreach (var thread in Workspace.Threads.Take(3))
                {
                    <SeekerChatRow Thread="thread" @key="thread.Chat.Id" />
                }
            </MudStack>
        </HomeSection>
    }

    @if (Workspace.ToRate.Count > 0)
    {
        <HomeSection Title="@T.Get(Copy.ToRateTitle)" Href="@SeekerRoutes.Reviews">
            @foreach (var pro in Workspace.ToRate.Take(2))
            {
                <ToRateRow Pro="pro" @key="pro.Id" />
            }
        </HomeSection>
    }
</MudStack>
