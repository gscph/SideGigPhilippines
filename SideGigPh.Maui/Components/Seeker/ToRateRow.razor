<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="py-3">
    <PersonAvatar Name="@Pro.DisplayName" PhotoUrl="@Pro.PhotoUrl" Size="Size.Large" />
    <MudStack Spacing="0" Class="flex-1 overflow-hidden">
        <MudText Typo="Typo.subtitle1" Class="one-line">@Pro.DisplayName</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@T.Trades(Pro)</MudText>
    </MudStack>
    <MudButton Variant="Variant.Outlined" Class="app-button-ink rounded-pill flex-shrink-0" StartIcon="@Icons.Material.Rounded.StarOutline"
               Href="@SeekerRoutes.Rate(Pro.Id)">
        @T.Get(Copy.Rate)
    </MudButton>
</MudStack>
