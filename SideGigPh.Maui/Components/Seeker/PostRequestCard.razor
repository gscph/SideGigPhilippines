<MudCard Outlined="true" Elevation="0" Class="app-raised">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="category-icon mud-background-gray rounded-lg">
                <MudImage Src="@AppImages.PostRequest" Alt="" Width="36" Height="36" aria-hidden="true" />
            </MudStack>
            <MudStack Spacing="0" Class="flex-1">
                <MudText Typo="Typo.subtitle1">@T.Get(Copy.HomePostTitle)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.HomePostWhy)</MudText>
            </MudStack>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3"
                   StartIcon="@Icons.Material.Rounded.Add" Href="@JobPostRoutes.New">
            @T.Get(Copy.HomePostButton)
        </MudButton>
    </MudCardContent>
</MudCard>
