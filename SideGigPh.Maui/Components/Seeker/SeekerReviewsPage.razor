@page "/me/reviews"
@layout SeekerLayout

<MudStack Spacing="4">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T.Get(Copy.ReviewsTitle)</MudText>

    @if (Workspace.ToRate.Count == 0 && Workspace.MyReviews.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.StarOutline" Text="@T.Get(Copy.SeekerReviewsEmpty)" />
    }

    @if (Workspace.ToRate.Count > 0)
    {
        <MudStack HtmlTag="section" Spacing="1">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.ToRateTitle)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ToRateWhy)</MudText>
            @foreach (var pro in Workspace.ToRate)
            {
                <ToRateRow Pro="pro" @key="pro.Id" />
            }
        </MudStack>
    }

    @if (Workspace.MyReviews.Count > 0)
    {
        <MudStack HtmlTag="section" Spacing="0">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.YourReviews)</MudText>
            @foreach (var review in Workspace.MyReviews)
            {
                var pro = Workspace.ThreadWith(review.ProfessionalId)?.Pro;
                <MudLink Href="@SeekerRoutes.Rate(review.ProfessionalId)" Underline="Underline.None" Color="Color.Inherit"
                         aria-label="@T.Get(Copy.EditYourReview)" @key="review.Id">
                    <ReviewRow Review="review" Name="@pro?.DisplayName" PhotoUrl="@pro?.PhotoUrl" />
                </MudLink>
                <MudDivider />
            }
        </MudStack>
    }
</MudStack>
