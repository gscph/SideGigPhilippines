@page "/me/reviews/rate/{Id}"

@if (_pro is not null)
{
    <InterviewStep Title="@T.Format(Copy.WriteReviewTitle, _pro.DisplayName)" Why="@T.Get(Copy.ToRateWhy)" OnBack="GoBack"
                   OnNext="SubmitAsync" NextLabel="@T.Get(Copy.SubmitReview)" CanContinue="@CanSubmit">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <PersonAvatar Name="@_pro.DisplayName" PhotoUrl="@_pro.PhotoUrl" Size="Size.Large" />
            <MudRating @bind-SelectedValue="_rating" Size="Size.Large" Color="Color.Warning" aria-label="@T.Get(Copy.StarsLabel)" />
            @if (AfterJob)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@T.Format(Copy.BlindNoteForm, _pro.DisplayName, BlindDays)</MudText>
            }
        </MudStack>
        <MudTextField T="string" @bind-Value="_comment" Immediate="true" Variant="Variant.Filled" Underline="false" Class="app-field" Lines="3" MaxLength="300"
                      Label="@T.Get(Copy.ReviewCommentPlaceholder)" />
        <MudTextField T="string" @bind-Value="_name" Immediate="true" Variant="Variant.Filled" Underline="false" Class="app-field" MaxLength="40"
                      Label="@T.Get(Copy.ReviewNameLabel)" Placeholder="@T.Get(Copy.ReviewNamePlaceholder)" autocomplete="name" />
        @if (_refused)
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@T.Get(Copy.TextNotAllowed)</MudAlert>
        }
    </InterviewStep>
}
