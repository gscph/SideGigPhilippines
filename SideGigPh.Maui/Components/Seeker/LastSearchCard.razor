<MudCard Outlined="true" Elevation="0">
    <MudCardContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Dark" aria-hidden="true" />
            <MudStack Spacing="0" Class="flex-1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T.Get(Copy.LastSearch)</MudText>
                <MudText Typo="Typo.subtitle2">@Summary</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" Href="@SeekerRoutes.Search">@T.Get(Copy.SeePros)</MudButton>
        </MudStack>
    </MudCardContent>
</MudCard>
