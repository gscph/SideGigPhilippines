@page "/me"
@layout SeekerLayout

<MePage Title="@T.Get(Copy.AccountTitle)" StartOverWarning="@T.Get(Copy.StartOverWarning)">
    <ProfileCard Name="@Workspace.Answers.ReviewerName" />

    <MudStack Spacing="3">
        <MudTextField T="string" @bind-Value="_name" Immediate="true" Variant="Variant.Filled" Underline="false" MaxLength="40"
                      Label="@T.Get(Copy.ReviewNameLabel)" Placeholder="@T.Get(Copy.ReviewNamePlaceholder)" Class="app-field" autocomplete="name" />
        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Large" FullWidth="true" Disabled="@(!NameChanged)" OnClick="SaveNameAsync">
            @T.Get(_saved && !NameChanged ? Copy.Saved : Copy.Save)
        </MudButton>
    </MudStack>

    <MudStack Spacing="0" Class="border-t border-solid mud-border-lines-default">
        <MenuRow Href="@SeekerRoutes.Reviews" Icon="@Icons.Material.Rounded.StarOutline"
                 Text="@T.Get(Copy.YourReviews)" SecondaryText="@ReviewsLabel" Badge="@Workspace.ToRate.Count" />
    </MudStack>
</MePage>
