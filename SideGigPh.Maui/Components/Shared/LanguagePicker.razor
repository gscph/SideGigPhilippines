<MudStack Spacing="2">
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">@T.Get(Copy.AccountLanguage)</MudText>
    <MudStack Row="true" Spacing="2" StretchItems="StretchItems.All">
        @foreach (var (language, label) in Languages)
        {
            <MudButton Variant="@(Value == language ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                       FullWidth="true" aria-pressed="@(Value == language ? "true" : "false")"
                       OnClick="() => ValueChanged.InvokeAsync(language)">
                @label
            </MudButton>
        }
    </MudStack>
</MudStack>
