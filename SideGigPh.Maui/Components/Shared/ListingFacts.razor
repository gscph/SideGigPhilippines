<MudStack Spacing="1">
    @if (Reviews is not null)
    {
        <ProCardFact Icon="@Icons.Material.Filled.Star" IconColor="Color.Warning" Text="@T.Stars(Reviews)" />
    }
    <ProCardFact Icon="@Icons.Material.Filled.Payments" IconColor="Color.Success" Text="@T.Rate(Listing)" />
    @if (T.Experience(Listing) is { } experience)
    {
        @if (Listing.IsSeasoned())
        {
            <ProCardFact Icon="@Icons.Material.Filled.WorkspacePremium" IconColor="Color.Primary" Highlight="true" Text="@experience" />
        }
        else
        {
            <ProCardFact Icon="@Icons.Material.Filled.Handyman" Text="@experience" />
        }
    }
    @if (T.Towns(Listing) is { Length: > 0 } towns)
    {
        <ProCardFact Icon="@Icons.Material.Filled.Place" Text="@T.Format(Copy.ServesFact, towns)" />
    }
</MudStack>
