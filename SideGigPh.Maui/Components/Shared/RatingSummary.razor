<MudStack Spacing="6">
    <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="pt-2">
        <MudText Typo="Typo.h2" HtmlTag="p">@Average</MudText>
        <MudRating SelectedValue="Rounded" ReadOnly="true" Size="Size.Small" Color="Color.Warning"
                   aria-label="@($"{Average}/5")" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">@CountLabel</MudText>
    </MudStack>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle2">@T.Get(Copy.OverallRating)</MudText>
        @foreach (var stars in Enumerable.Range(1, 5).Reverse())
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.caption">@stars</MudText>
                <MudProgressLinear Value="@Share(stars)" Color="Color.Dark" Rounded="true" Size="Size.Small" Class="flex-1" />
            </MudStack>
        }
    </MudStack>
</MudStack>
