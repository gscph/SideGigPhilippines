<MudCard Outlined="true" Elevation="1" Class="@Class">
    <MudCardHeader Class="pb-0">
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" aria-hidden="true">@Initials</MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6" HtmlTag="h2">@Listing.DisplayName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Trades</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <MudStack Spacing="3">
            @if (!string.IsNullOrEmpty(Highlight))
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                         Icon="@Icons.Material.Filled.Check" Class="ma-0 align-self-start">@Highlight</MudChip>
            }

            @if (ServiceLabels.Count > 0)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    @foreach (var service in ServiceLabels)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="ma-0">@service</MudChip>
                    }
                </MudStack>
            }

            <MudStack Spacing="1">
                <ProCardFact Icon="@Icons.Material.Filled.Payments" Text="@Rate" />
                @if (ExperienceLabel is not null)
                {
                    <ProCardFact Icon="@Icons.Material.Filled.Handyman" Text="@T.Format(Copy.ExperienceFact, ExperienceLabel)" />
                }
                @if (!string.IsNullOrEmpty(Towns))
                {
                    <ProCardFact Icon="@Icons.Material.Filled.Place" Text="@T.Format(Copy.ServesFact, Towns)" />
                }
            </MudStack>
        </MudStack>
    </MudCardContent>

    @if (Actions is not null)
    {
        <MudCardActions Class="px-4 pb-4 pt-0">
            <MudStack Row="true" Spacing="2" StretchItems="StretchItems.All" Class="mud-width-full">
                @Actions
            </MudStack>
        </MudCardActions>
    }
</MudCard>
