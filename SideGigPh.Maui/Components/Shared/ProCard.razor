@if (Dense)
{
    <MudCard Outlined="true" Elevation="1" Class="@Class">
        <MudCardContent Class="pa-3">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start">
                <PersonAvatar Name="@Listing.DisplayName" PhotoUrl="@Listing.PhotoUrl" Size="Size.Large" />
                <MudStack Spacing="1" Class="flex-1 app-min-w-0">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="one-line">@Listing.DisplayName</MudText>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                        <TradeBadge Listing="Listing" />
                        @if (!string.IsNullOrEmpty(Highlight))
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Check" Class="ma-0">@Highlight</MudChip>
                        }
                    </MudStack>
                    <ListingFacts Listing="Listing" Reviews="Reviews" ServiceId="@ServiceId" Dense="true" />
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>
}
else
{
    <MudCard Outlined="true" Elevation="1" Class="@Class">
        <MudCardHeader Class="pb-0">
            <CardHeaderAvatar>
                <PersonAvatar Name="@Listing.DisplayName" PhotoUrl="@Listing.PhotoUrl" Size="Size.Large" />
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" HtmlTag="h2">@Listing.DisplayName</MudText>
                <TradeBadge Listing="Listing" Class="mt-1" />
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <MudStack Spacing="3">
                @if (!string.IsNullOrEmpty(Highlight))
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                             Icon="@Icons.Material.Filled.Check" Class="ma-0 align-self-start">@Highlight</MudChip>
                }

                @if (Listing.WorkPhotoUrls.Count > 0)
                {
                    <MudStack Row="true" Spacing="2">
                        @foreach (var url in Listing.WorkPhotoUrls.Take(MaxThumbnails))
                        {
                            <MudImage Src="@url" Alt="" ObjectFit="ObjectFit.Cover" Class="work-thumb rounded-lg" />
                        }
                    </MudStack>
                }

                <ServiceChips Listing="Listing" />
                <ListingFacts Listing="Listing" Reviews="Reviews" ServiceId="@ServiceId" />
            </MudStack>
        </MudCardContent>
    </MudCard>
}
