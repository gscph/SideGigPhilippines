<MudStack Spacing="2" Class="py-5">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <PersonAvatar Name="@DisplayName" PhotoUrl="@PhotoUrl" Size="Size.Large" />
        <MudStack Spacing="0" Class="flex-1 overflow-hidden">
            <MudText Typo="Typo.subtitle1" Class="one-line">@DisplayName</MudText>
            @if (ServiceLabel is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="one-line">@ServiceLabel</MudText>
            }
        </MudStack>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudRating SelectedValue="Review.Rating" ReadOnly="true" Size="Size.Small" Color="Color.Warning"
                   aria-label="@($"{Review.Rating}/5")" />
        @if (Review.VerifiedJob)
        {
            <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Rounded.Verified"
                     Class="ma-0">@T.Get(Copy.VerifiedService)</MudChip>
        }
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="flex-1">@T.Ago(Review.At)</MudText>
        @if (ReportHref is not null)
        {
            <MudIconButton Icon="@Icons.Material.Rounded.OutlinedFlag" Size="Size.Small" Color="Color.Secondary" Href="@ReportHref"
                           aria-label="@T.Get(Copy.ReportButton)" />
        }
    </MudStack>
    @if (!string.IsNullOrWhiteSpace(Review.Comment))
    {
        <MudText Typo="Typo.body1">@Review.Comment</MudText>
    }
    @if (Review.Locked)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Small" Color="Color.Secondary" aria-hidden="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Get(Copy.ReviewLockedNote)</MudText>
        </MudStack>
    }
    @if (Review.Hidden)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Rounded.VisibilityOff" Size="Size.Small" Color="Color.Secondary" aria-hidden="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@T.Format(Copy.ReviewHiddenForNow, BlindDays)</MudText>
        </MudStack>
    }
</MudStack>
