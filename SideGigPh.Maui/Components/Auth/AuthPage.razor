@page "/verify"

<MudContainer MaxWidth="MaxWidth.ExtraSmall">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="6" Class="full-screen py-8">
        <BrandMark Tagline="Find trusted local pros — or earn with your skills." />

        <MudPaper Outlined="true" Elevation="2" Class="pa-6 mud-width-full">
            <MudStack Spacing="5">
                <PhoneSignIn OnAuthenticated="HandleAuthenticated" />

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudDivider Class="flex-1" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">or</MudText>
                    <MudDivider Class="flex-1" />
                </MudStack>

                <GoogleSignInButton OnAuthenticated="HandleAuthenticated" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>
