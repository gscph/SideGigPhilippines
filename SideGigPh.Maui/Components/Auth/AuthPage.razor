@page "/"

<div class="auth">
    <div class="auth__brand">
        <svg class="auth__logo" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="var(--color-primary)" />
            <circle cx="12" cy="9" r="2.6" fill="#ffffff" />
        </svg>
        <h1 class="auth__name">SideGigPh</h1>
        <p class="auth__tagline">Find trusted local pros — or earn with your skills.</p>
    </div>

    <div class="auth__card">
        <PhoneSignIn OnAuthenticated="HandleAuthenticated" />

        <div class="auth__divider"><span>or</span></div>

        <GoogleSignInButton OnAuthenticated="HandleAuthenticated" />

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="auth__error" role="alert">@_error</p>
        }
    </div>
</div>
