<Project Sdk="Microsoft.NET.Sdk">

  <!-- A local MCP server (Model Context Protocol, stdio) that answers questions about our usage events (dbo.app_events)
       and the app's error reports (dbo.ErrorReports) with read-only EF Core queries on SideGigPhDb. Runs on the team's PC only, never
       deployed; see README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SideGigPh.AzureSQL\SideGigPh.AzureSQL.csproj" />
  </ItemGroup>

</Project>
