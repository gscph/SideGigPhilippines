@if (_loading)
{
    <MudStack Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
    </MudStack>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Try again</MudButton>
}
else if (Badges.Pending.Count == 0)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-12">
        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Success" Size="Size.Large" />
        <MudText Typo="Typo.h6">No badge requests waiting.</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Dark" OnClick="LoadAsync">Reload</MudButton>
    </MudStack>
}
else
{
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Badges.Pending.Count waiting, oldest first</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Dark" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">Reload</MudButton>
        </MudStack>
        @foreach (var request in Badges.Pending)
        {
            <BadgeRequestCard @key="request.Id" Request="request" OnDecided="StateHasChanged" />
        }
    </MudStack>
}
