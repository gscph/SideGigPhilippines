<MudCard Outlined="true">
    <MudCardContent>
        <MudStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
            @if (Request.ProfilePhotoUrl is { } photo)
            {
                <MudImage Src="@photo" Alt="Profile photo" Class="admin-profile-photo" />
            }
            else
            {
                <MudAvatar Size="Size.Large" Color="Color.Dark">?</MudAvatar>
            }
            <MudStack Spacing="1" Class="flex-1">
                <MudText Typo="Typo.h6">@BadgeText.Title(Request)</MudText>
                <MudText Typo="Typo.body1">@(Request.WorkerName ?? "(no name)")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Sent @Request.CreatedAt.ToManila() · uid @Request.Uid</MudText>
            </MudStack>
        </MudStack>

        @if (BadgeText.Scan(Request) is { Length: > 0 } scan)
        {
            <MudStack Spacing="0" Class="mt-4">
                <MudText Typo="Typo.subtitle2">@scan</MudText>
                @if (Request.ScannedType is { } type) { <MudText Typo="Typo.body2">Type: @type</MudText> }
                @if (Request.ScannedName is { } name) { <MudText Typo="Typo.body2">Name: @name</MudText> }
                @if (Request.ScannedNumber is { } number) { <MudText Typo="Typo.body2">Number: @number</MudText> }
                @if (Request.ScannedExpiry is { } expiry) { <MudText Typo="Typo.body2">Expires: @expiry.ToString("d MMM yyyy")</MudText> }
                @if (Request.ScanConfidence is { } sure) { <MudText Typo="Typo.body2">AI sure it's an ID: @Math.Round(sure * 100)%</MudText> }
            </MudStack>
        }

        @if (Request.PhotoProblems is not null || Request.PhotoSharpness is not null)
        {
            <MudStack Spacing="0" Class="mt-4">
                <MudText Typo="Typo.subtitle2">Photo check</MudText>
                <MudText Typo="Typo.body2" Color="@(Request.PhotoProblems is { Count: > 0 } ? Color.Error : Color.Default)">@BadgeText.PhotoCheck(Request)</MudText>
                @if (Request.PhotoSharpness is { } sharpness)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sharpness @Math.Round(sharpness) (under @BadgeText.BlurryBelow looks blurry)</MudText>
                }
            </MudStack>
        }

        @if (BadgeService.NeedsValidUntil(Request))
        {
            <ClearanceChecklist Qr="@Request.ScannedQr" @bind-ValidUntil="_validUntil" Disabled="_busy" />
        }

        <MudStack Spacing="2" Class="mt-4">
            @if (_document is not null)
            {
                <MudImage Src="@_document" Alt="Proof photo (small preview)" Class="admin-proof-thumb" />
                <MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.ZoomIn"
                           OnClick="OpenViewerAsync" Class="align-self-start">
                    View full size
                </MudButton>
            }
            else if (Request.HasDocument)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Dark" StartIcon="@Icons.Material.Outlined.Image"
                           Disabled="_busy" OnClick="ShowDocumentAsync" Class="align-self-start">
                    Show the proof photo (logged)
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No proof photo stored.</MudText>
            }
        </MudStack>

        <MudStack Spacing="1" Class="mt-4">
            <MudText Typo="Typo.subtitle2">Why reject?</MudText>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                @foreach (var (code, label) in BadgeText.RejectReasons)
                {
                    <MudChip T="string" Size="Size.Small" Disabled="_busy" Color="@(_code == code ? Color.Primary : Color.Dark)"
                             Variant="@(_code == code ? Variant.Filled : Variant.Outlined)" OnClick="() => PickCode(code, label)">@label</MudChip>
                }
            </MudStack>
        </MudStack>

        <MudTextField T="string" @bind-Value="_reason" Label="Reason if you reject (the worker reads it)"
                      Variant="Variant.Filled" Lines="2" MaxLength="BadgeService.MaxReason" Counter="BadgeService.MaxReason"
                      Immediate="true" Class="mt-4" />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </MudCardContent>
    <MudCardActions Class="px-4 pb-4">
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(_busy || !BadgeService.CanApprove(Request, _validUntil))"
                       OnClick="() => DecideAsync(true)">Approve</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_busy || !BadgeService.CanReject(_reason)"
                       OnClick="() => DecideAsync(false)">Reject</MudButton>
        </MudStack>
    </MudCardActions>
</MudCard>
