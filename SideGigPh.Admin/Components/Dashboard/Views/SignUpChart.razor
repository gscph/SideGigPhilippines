<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h6">Sign-ups, last @Days.Count days</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Days.Sum(d => d.Seekers + d.Workers + d.NoRole).Count() new accounts (Philippine days), by the side each is on now
        </MudText>
        <MudChart T="double" ChartType="ChartType.StackedBar" ChartSeries="_series" ChartLabels="_labels" Height="280px" Width="100%" />
    </MudStack>
</MudPaper>
