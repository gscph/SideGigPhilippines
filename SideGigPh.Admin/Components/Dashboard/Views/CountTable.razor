<MudPaper Outlined="true" Class="pa-4 mud-height-full">
    <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>
    @if (Rows.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing yet.</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var row in Rows)
            {
                <MudStack Spacing="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@row.Label</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@row.Count.Count()</MudText>
                    </MudStack>
                    <MudProgressLinear Color="Color.Primary" Value="Share(row)" Rounded="true" Size="Size.Small" />
                </MudStack>
            }
        </MudStack>
    }
</MudPaper>
