@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}
<MudDataGrid @ref="_grid" T="AdminSeekerDto" ServerData="LoadAsync" Hover="true" Dense="true" SortMode="SortMode.Single"
             RowsPerPage="AdminLists.DefaultTake" Elevation="0" Outlined="true">
    <ToolBarContent>
        <ListToolbar Search="@_search" SearchChanged="OnSearchAsync" SearchHint="Name, number or uid"
                     Filter="@_town" FilterChanged="OnTownAsync" FilterLabel="Town" Filters="_towns" Total="_total" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Household">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@(context.Item.Name ?? "(no name)")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.Uid</MudText>
                </MudStack>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Phone" Title="Number" Sortable="false" />
        <PropertyColumn Property="x => x.Town" Title="Town" Sortable="false" />
        <PropertyColumn Property="x => x.Posts" Title="Posts">
            <CellTemplate>@context.Item.Posts (@context.Item.OpenPosts open)</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Chats" Title="Chats" Sortable="false" />
        <PropertyColumn Property="x => x.CompletedJobs" Title="Jobs done" />
        <PropertyColumn Property="x => x.ReviewsWritten" Title="Reviews" Sortable="false" />
        <PropertyColumn Property="x => x.Language" Title="Language" Sortable="false" />
        <PropertyColumn Property="x => x.CreatedAt" Title="Joined">
            <CellTemplate>@context.Item.CreatedAt.ToManila()</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.LastActiveAt" Title="Last seen">
            <CellTemplate>@context.Item.LastActiveAt.Ago(_now)</CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary">No households match.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="AdminSeekerDto" PageSizeOptions="ListPaging.PageSizes" />
    </PagerContent>
</MudDataGrid>
