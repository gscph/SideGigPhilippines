@inherits LayoutComponentBase

<MudThemeProvider Theme="AdminTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="admin-appbar">
        <MudText Typo="Typo.h6" Color="Color.Primary">Tarbaho</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ml-2">operator</MudText>
