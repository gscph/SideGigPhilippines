<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The operator's web site (standalone Blazor WebAssembly, static files only, served by the Function App at /api/operator/): signs in with Firebase (Google)
       and calls SideGigPh.Api's admin/… routes. No server of its own: deploy-api.yml publishes it into the API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SideGigPh.Admin</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
    <!-- Same version as the phone app (MobileAppTheme.csproj). -->
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SideGigPh.Contracts\SideGigPh.Contracts.csproj" />
  </ItemGroup>

</Project>
